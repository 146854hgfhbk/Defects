{
  "schema_version": 1,
  "language": "swift",
  "required_dependency_source": "spm-remote",
  "allowed_remote_prefixes": [
    "https://github.com/"
  ],
  "toolchain": {
    "name": "swift",
    "versions": [
      "5.10.1",
      "5.9.2",
      "5.8.1",
      "6.0.3"
    ],
    "default": "5.10.1",
    "image_template": "swift-defects-validation:{version}-v1",
    "registry_fallback": "docker.m.daocloud.io"
  },
  "test_runner": {
    "command": [
      "swift",
      "test"
    ],
    "selector_grammar": "TestSuite/testCase",
    "serial_flag": [
      "--num-workers",
      "1"
    ]
  },
  "dependency": {
    "lock_file": "Package.resolved",
    "manifest_file": "Package.swift",
    "cache_root_env": "SPM_CACHE",
    "checkouts_dir": ".build/checkouts"
  },
  "reject": {
    "xcode_markers": true,
    "gui_platform_imports": true,
    "non_allowed_remotes": true,
    "generated_paths": true
  }
}
