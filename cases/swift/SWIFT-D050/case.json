    "buggy_baseline_is_parent": true,
    "single_parent_matches_baseline": true,
    "commit_message": "Fix SWAR string scanner returning early on escaped quotes in alignment phase\n\nThe alignment phase that byte-scans up to the first 8-byte boundary\nwas missing the escape check when it found a '\"'. It assumed any '\"'\nin that phase was the closing quote of the string. This caused strings\nlike \"\\\"value\\\"\" to be scanned as if they ended at the first '\"' (the\nescaped one), leaving the parser mid-string and producing a spurious\nexpectedComma error.\n\nThe SWAR bulk-scan and the remaining-bytes tail already perform the\nbackwards-backslash count; the alignment phase now does the same.\n\nFixes #60.\n\nCo-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>",
    "boundary_evidence": "repair/boundary-verification.json",
    "boundary_evidence_sha256": "dbef163bd94f6acb8496272dcf65b8f57cd201589f7a4d68286c8baef8aa3268"
  },
