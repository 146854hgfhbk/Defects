@@ -98,9 +98,17 @@ private struct ECDSASigner: JWTAlgorithm, OpenSSLSigner {
         // see: https://tools.ietf.org/html/rfc7515#appendix-A.3
         var rBytes = [UInt8](repeating: 0, count: 32)
