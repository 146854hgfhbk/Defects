#!/usr/bin/env bash
set -euo pipefail
root=__REFERENCE_USER_HOME__/swift-defects-miner-review
cwd=$(pwd -P)
case "$cwd/" in
  "$root/"*) ;;
  *) printf 'Swift workspace must be inside %s\n' "$root" >&2; exit 2 ;;
esac
image=${H60_SWIFT_IMAGE:-sha256:da8756f80cc1f5df7a777e662785a70fc990d06bd51d8fa02929366c30d98778}
swift=${H60_SWIFT_BIN:-/opt/swift623/usr/bin/swift}
case "$PWD" in
  */SWIFT-029/*) set -- "$@" -Xlinker -Bsymbolic ;;
esac
exec docker run --rm --init --network none --cpus 4 \
  --user "$(id -u):$(id -g)" \
  -e HOME=/tmp/home -e TMPDIR=/tmp \
  -e CLANG_MODULE_CACHE_PATH=/tmp/clang-module-cache \
  -e SWIFTPM_MODULECACHE_OVERRIDE=/tmp/swiftpm-module-cache \
  -e GIT_CONFIG_COUNT=1 -e GIT_CONFIG_KEY_0=safe.directory -e 'GIT_CONFIG_VALUE_0=*' \
  -e GIT_NO_LAZY_FETCH=1 \
  --tmpfs /tmp/home:rw,mode=1777 \
  --volume "$root:$root" \
  --volume "${H60_SPM_CACHE:-$root/workspaces/h60-pilot-cache}:/tmp/home/.cache/org.swift.swiftpm" \
  --workdir "$cwd" \
  "$image" "$swift" "$@"
