diff --git a/lib/reverse_proxy_plug/http_client.ex b/lib/reverse_proxy_plug/http_client.ex
index 2c1f6ed..5491aa6 100644
--- a/lib/reverse_proxy_plug/http_client.ex
+++ b/lib/reverse_proxy_plug/http_client.ex
@@ -10,4 +10,8 @@ defmodule ReverseProxyPlug.HTTPClient do
                | __MODULE__.AsyncResponse.t()
                | __MODULE__.MaybeRedirect.t()}
               | {:error, error()}
+
+  @callback stream_response(__MODULE__.AsyncResponse.t()) :: Enumerable.t()
+
+  @optional_callbacks stream_response: 1
 end
diff --git a/lib/reverse_proxy_plug/http_client/adapters/httpoison.ex b/lib/reverse_proxy_plug/http_client/adapters/httpoison.ex
index 925e8ea..3f384dc 100644
--- a/lib/reverse_proxy_plug/http_client/adapters/httpoison.ex
+++ b/lib/reverse_proxy_plug/http_client/adapters/httpoison.ex
@@ -68,5 +68,27 @@ if Code.ensure_loaded?(HTTPoison) do
     defp translate_mod(HTTPoison.AsyncResponse), do: HTTPClient.AsyncResponse
     defp translate_mod(HTTPoison.MaybeRedirect), do: HTTPClient.MaybeRedirect
     defp translate_mod(HTTPoison.Error), do: HTTPClient.Error
+
+    @impl HTTPClient
+    def stream_response(_resp) do
+      Stream.unfold(nil, fn _ ->
+        receive do
+          %HTTPoison.AsyncStatus{code: code} ->
+            {{:status, code}, nil}
+
+          %HTTPoison.AsyncHeaders{headers: headers} ->
+            {{:headers, headers}, nil}
+
+          %HTTPoison.AsyncChunk{chunk: chunk} ->
+            {{:chunk, chunk}, nil}
+
+          %HTTPoison.Error{reason: reason} ->
+            {{:error, %HTTPClient.Error{reason: reason}}, nil}
+
+          %HTTPoison.AsyncEnd{} ->
+            nil
+        end
+      end)
+    end
   end
 end
