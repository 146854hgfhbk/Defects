+      sorted[idx].value = nvalue
+      sort(sorted)
+      heap:update(payload, nvalue)
+      testheap(heap, sorted)
+    end)
+    
+    it("Tests updating a middle item", function()
+      local heap, sorted, sreverse = newheap()
+      local idx = 4
