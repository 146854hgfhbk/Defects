diff --git a/XS.xs b/XS.xs
index e66ce60..120aa2f 100755
--- a/XS.xs
+++ b/XS.xs
@@ -2003,7 +2003,15 @@ encode_sv (pTHX_ enc_t *enc, SV *sv, SV *typesv)
     }
 
   if (UNLIKELY (!(SvOK (typesv)) && (enc->json.flags & F_TYPE_ALL_STRING)))
