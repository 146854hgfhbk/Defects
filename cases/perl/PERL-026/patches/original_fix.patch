+    if ((svp = hv_fetchs (csv->self, "_ERROR_FLD", FALSE)) && *svp) {
+	if (SvIOK (*svp)) (void)fprintf (stderr, "FLD: %d\n", SvIV (*svp));
+	}
+    } /* ErrorDiag */
+
 #define ParseError(csv,xse,pos)	cx_ParseError (aTHX_ csv, xse, pos)
