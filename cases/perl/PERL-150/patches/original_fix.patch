diff --git a/XS.pm b/XS.pm
index 7d41ac4..f6836d6 100644
--- a/XS.pm
+++ b/XS.pm
@@ -2224,6 +2224,10 @@ BEGIN {
         return $obj ? 1 == $op : 0 == $op;
       }
     },
+    'ne'     => sub {
+      my ($obj, $op) = ref ($_[0]) ? ($_[0], $_[1]) : ($_[1], $_[0]);
+      return !($obj eq $op);
+    },
     fallback => 1);
 }
 
