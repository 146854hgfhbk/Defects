diff --git a/t/Legacy/Regression/6_cmp_ok.t b/t/Legacy/Regression/6_cmp_ok.t
new file mode 100644
index 000000000..05cfcba9a
--- /dev/null
+++ b/t/Legacy/Regression/6_cmp_ok.t
@@ -0,0 +1,17 @@
+use Test::More;
+
+use Test2::API qw/intercept/;
+
+my $events = intercept {
+    local $SIG{__WARN__} = sub { 1 };
+    my $foo = undef;
+    cmp_ok($foo, "ne", "");
+};
+
+is($events->[-1]->message, <<EOT, "Got useful diag");
+    undef
+        ne
+    ''
+EOT
+
+done_testing;
