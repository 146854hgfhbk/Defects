+subtest "tempfile, instance method, overridden DIR" => sub {
+    my $wd = tempd;
+
+    my $basedir = Path::Tiny->cwd;
+    my $repodir = $basedir->child('whatever');
+    $repodir->remove_tree if $repodir->exists;
