index 000000000..dd4e0b464
--- /dev/null
+++ b/t/regression/812-todo.t
@@ -0,0 +1,21 @@
+use strict;
+use warnings;
+
+use Test2::API qw/intercept/;
+use Test::More;
+
+my @values = (
+    "",               # false but defined -> inconsistent
+    0,                # false but defined -> inconsistent
+    0.0,              # false but defined -> inconsistent
+    "0.0",            # true -> TODO
+    "this is why",    # as expected
+);
+
+for my $value (@values) {
+    local $TODO = $value;
+    my $x = defined($value) ? "\"$value\"" : 'UNDEF';
+    fail "Testing: $x";
+}
+
+done_testing;
