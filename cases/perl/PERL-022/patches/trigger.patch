--- a/t/basic.t
+++ b/t/basic.t
@@ -161,20 +161,29 @@ is $file->parent,  '/foo/baz';
     );
 
     for my $test (@tests) {
-        is(path($test->[0]), defined $test->[1] ? $test->[1] : $test->[0], $test->[2]);
+        my $path = path($test->[0]);
+        my $internal_path = $path->[0]; # Avoid stringification adding a "./" prefix
+        is($internal_path, defined $test->[1] ? $test->[1] : $test->[0], $test->[2]);
     }
 
