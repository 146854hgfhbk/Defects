+    my @cases = qw(
+        /foo/bar/baz"
+        ./~root
+    );
+
+    for my $c ( @cases ) {
+        my $path = path($c);
+        is( Path::Tiny->THAW( "fake", $path->FREEZE("fake") ),
+            $path, "FREEZE-THAW roundtrip: $c" );
+    }
 }
 
