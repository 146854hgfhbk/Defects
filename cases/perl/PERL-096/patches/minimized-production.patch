--- a/XS.xs
+++ b/XS.xs
@@ -425,7 +425,9 @@ enum {
   INCR_M_BS,     /* inside backslash */
   INCR_M_C0,     /* inside comment in initial whitespace sequence */
   INCR_M_C1,     /* inside comment in other places */
