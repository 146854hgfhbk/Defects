diff --git a/t/all_any_noclobber_dollar_at.t b/t/all_any_noclobber_dollar_at.t
new file mode 100644
index 0000000000000000000000000000000000000000..96009335f3bc818243a58467c3b4956a71903fe9
--- /dev/null
+++ b/t/all_any_noclobber_dollar_at.t
@@ -0,0 +1,17 @@
+use strict;
+use warnings;
+use lib 't/lib';
+
+use Std;
+
+{
+    $@ = 'hello';
+    all(123);
+    is( $@, 'hello', 'all() doesn’t overwrite $@' );
+}
+
+{
+    $@ = 'hello';
+    any(123);
+    is( $@, 'hello', 'any() doesn’t overwrite $@' );
+}
