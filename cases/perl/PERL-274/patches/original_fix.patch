diff --git a/lib/Test2/API/Instance.pm b/lib/Test2/API/Instance.pm
index c72199253..39a3cd022 100644
--- a/lib/Test2/API/Instance.pm
+++ b/lib/Test2/API/Instance.pm
@@ -455,8 +455,10 @@ sub _ipc_wait {
                 last if $pid == -1;
                 next unless $err;
                 $fail++;
-                $err = $err >> 8;
-                warn "Process $pid did not exit cleanly (status: $err)\n";
+
+                my $sig = $err & 127;
+                my $exit = $err >> 8;
+                warn "Process $pid did not exit cleanly (wstat: $err, exit: $exit, sig: $sig)\n";
             }
 
             alarm 0;
diff --git a/t/Test2/modules/API/Instance.t b/t/Test2/modules/API/Instance.t
index 33e515464..8e7e9a8a3 100644
--- a/t/Test2/modules/API/Instance.t
