diff --git a/t/Legacy/Regression/736_use_ok.t b/t/Legacy/Regression/736_use_ok.t
new file mode 100644
index 000000000..f9a64ee25
--- /dev/null
+++ b/t/Legacy/Regression/736_use_ok.t
@@ -0,0 +1,31 @@
+use warnings;
+use strict;
+use Test::More;
+
+BEGIN {
+    $INC{'MyWarner.pm'} = 1;
+    package MyWarner;
+
+    sub import {
+        warnings::warnif('deprecated', "Deprected! run for your lives!");
+    }
+}
+
+sub capture(&) {
+    my $warn;
+    local $SIG{__WARN__} = sub { $warn = shift };
+    $_[0]->();
+    return $warn || "";
+}
+
+my $file = __FILE__;
+my $line = __LINE__ + 2;
+like(
+    capture { use_ok 'MyWarner' },
+    qr/^Deprected! run for your lives! at \Q$file\E line $line/,
+    "Got the warning"
+);
+
+ok(!capture { no warnings 'deprecated'; use_ok 'MyWarner' }, "No warning");
+
+done_testing;
