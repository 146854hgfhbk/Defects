 "issue_evidence": {
  "issue_id": 80,
  "title": "RangeError when input string contains \\r\\n and a pattern matches an empty string",
  "state": "closed",
  "body_excerpt": "LineScanner throws RangeError (length) when scanning a zero-length match positioned between a CR and LF in a string containing \\r\\n. The \\n case works normally, but the \\r\\n case crashes. Minimal reproduction: scanner.expect('foo\\nbar\\r'); scanner.expect(RegExp('(?!x)')) crashes with RangeError.",
  "expected": "scanning a zero-length match between CR and LF must not throw; line/column must be reported correctly",
  "upstream_fix": "commit 084b201c 'Avoid treating /r as newline on it' (PR #81) with regression test",
  "transfer": "issue officially transferred from dart-archive/string_scanner#80 to dart-lang/tools#1797"
 },
