 "issue_evidence": {
  "issue_id": 511,
  "title": "Header injection and path forgery [security issue]",
  "state": "closed",
  "reporter": "n0npax",
  "opened": "2020-12-23",
  "body_excerpt": "I believe there is a security issue with the current implementation of Request. Request is passing method verb as is to the stream without any kind of validation. If the HTTP verb(method) is not a part of the known set of verbs (GET/PUT/HEAD/...) I'd expect an exception to be thrown. This is a security risk: if a developer accepts a method param from the user, the user can do header injection or path forgery (CRLF injection), exploitable especially behind a reverse proxy.",
  "expected": "an exception should be thrown for methods outside the known set"
 },
