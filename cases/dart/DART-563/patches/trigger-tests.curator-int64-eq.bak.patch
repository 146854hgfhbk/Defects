diff --git a/pkgs/fixnum/test/int64_eq_test.dart b/pkgs/fixnum/test/int64_eq_test.dart
new file mode 100644
--- /dev/null
+++ b/pkgs/fixnum/test/int64_eq_test.dart
@@ -0,0 +1,14 @@
+import 'package:fixnum/fixnum.dart';
+import 'package:test/test.dart';
+
+void main() {
+  test('Int64 == compares numeric value correctly', () {
+    expect(Int64(5) == 5, isTrue);
+    expect(Int64(5) == Int64(5), isTrue);
+    final IntX other = Int32(5);
+    expect(Int64(5) == other, isTrue);
+    expect(Int64(5) == Int64(6), isFalse);
+    final Object str = 'x';
+    expect(Int64(5) == str, isFalse);
+  });
+}
