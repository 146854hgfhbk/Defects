diff --git a/test/subject_int_test.dart b/test/subject_int_test.dart
new file mode 100644
--- /dev/null
+++ b/test/subject_int_test.dart
@@ -0,0 +1,20 @@
+import 'package:dart_jsonwebtoken/dart_jsonwebtoken.dart';
+import 'package:test/test.dart';
+
+void main() {
+  test('int subject claim is parsed as string', () {
+    final jwt = JWT({'sub': 123456789});
+    final token = jwt.sign(SecretKey('secret passphrase'));
+    final verified = JWT.tryVerify(token, SecretKey('secret passphrase'));
+    expect(verified, isNotNull);
+    expect(verified!.subject, '123456789');
+  });
+
+  test('string subject claim stays string', () {
+    final jwt = JWT({'sub': 'user-42'});
+    final token = jwt.sign(SecretKey('secret passphrase'));
+    final verified = JWT.tryVerify(token, SecretKey('secret passphrase'));
+    expect(verified, isNotNull);
+    expect(verified!.subject, 'user-42');
+  });
+}
