+  group("line numbers have appropriate padding", () {
+    test("with line number 9", () {
+      expect(
+          SourceFile.fromString("\n" * 8 + "foo bar baz\n")
+              .span(8, 11)
+              .highlight(),
+          equals("""
+  ,
+9 | foo bar baz
