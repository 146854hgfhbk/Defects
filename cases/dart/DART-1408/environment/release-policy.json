{
  "schema_version": 1,
  "target_active_cases": 100,
  "minimum_validation_repetitions": 3,
  "minimum_full_suite_repetitions": 1,
  "require_analyze_clean": false,
  "maximum_active_cases_per_project": 5,
  "minimum_distinct_projects_at_target": 20,
  "required_dependency_source": "pub.dev",
  "required_network_isolation": "os_enforced",
  "disallowed_license_spdx": [
    "",
    "NOASSERTION",
    "NONE",
    "OTHER"
  ],
  "require_public_repository": true,
  "require_repository_bundle": true,
  "require_offline_reproduction": true,
  "require_human_curation": false,
  "required_curation_method": "llm_api_consensus",
  "minimum_llm_curation_reviews": 2
}
