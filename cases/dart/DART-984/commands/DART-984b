#!/usr/bin/env bash
set -euo pipefail
case_dir="$(cd "$(dirname "$0")/.." && pwd)"
workspace="${DART_REPRO_WORKSPACE:-${XDG_CACHE_HOME:-$HOME/.cache}/dart-defects4j/DART-984}"
mkdir -p "${workspace}/home" "${workspace}/tmp"
image="dart-defects-repro-2-13-4"
if ! docker image inspect "${image}" >/dev/null 2>&1; then
  echo "Building SDK-locked reproduction image ${image}"
  docker build --network=default -f "${case_dir}/environment/Dockerfile.reproduction" -t "${image}" "${case_dir}"
fi

if [[ ! -f "${workspace}/prepared/bootstrap-receipt.json" ]]; then
  "${case_dir}/commands/DART-984-prepare"
fi
rm -rf "${workspace}/DART-984b"
mkdir -p "${workspace}/DART-984b"
docker run --rm --init --network none \
  --user "$(id -u):$(id -g)" \
  --env HOME=/workspace/home \
  --env DART_ASCII_WORKSPACE_ROOT=/workspace \
  --env TMPDIR=/workspace/tmp --env TEMP=/workspace/tmp --env TMP=/workspace/tmp \
  --env DART_VALIDATION_NETWORK_ISOLATION=os_enforced \
  --env DART_VALIDATION_DEPENDENCY_MODE=offline \
  --volume "${case_dir}:/case:ro" \
  --volume "${workspace}:/workspace" \
  "${image}" python -u /case/tools/reproduce_case.py \
    --case /case/case.json --version buggy \
    --prepared-root /workspace/prepared \
    --workspace /workspace/DART-984b
printf "Offline reproduction workspace: %s\n" "${workspace}"
