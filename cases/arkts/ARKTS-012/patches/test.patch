+import AbilityDelegatorRegistry from '@ohos.app.ability.abilityDelegatorRegistry'
+import { Driver, ON } from '@ohos.UiTest'
+import { describe, it, expect } from '@ohos/hypium'
+
+const BUNDLE = 'CertCount_'
+const abilityDelegator = AbilityDelegatorRegistry.getAbilityDelegator()
+
+async function startCertFrameworkAbility() {
+  await abilityDelegator.startAbility({
+    bundleName: 'com.samples.certframework',
+    abilityName: 'EntryAbility'
+  })
+}
+
+async function expectInitialCountersUseExactZero(driver: Driver) {
+  let legacyCounters = await driver.findComponents(ON.text('0/100'))
+  let legacyCounterCount = legacyCounters ? legacyCounters.length : 0
+  expect(legacyCounterCount).assertEqual(0)
+
+  let zeroCounters = await driver.findComponents(ON.text('0'))
+  let zeroCounterCount = zeroCounters ? zeroCounters.length : 0
+  expect(zeroCounterCount >= 3).assertTrue()
+}
+
+export default function certCountTest() {
+  describe('certCountTest', () => {
+    it(BUNDLE + 'InitialCounterLabels_001', 0, async (done: Function) => {
+      let driver = Driver.create()
+      await startCertFrameworkAbility()
+      await driver.delayMs(1000)
+
+      await driver.assertComponentExist(ON.id('tab_certframework'))
+      let certFrameworkTab = await driver.findComponent(ON.id('tab_certframework'))
+      await certFrameworkTab.click()
+      await driver.delayMs(200)
+      await expectInitialCountersUseExactZero(driver)
+
+      await driver.assertComponentExist(ON.id('tab_certchain'))
+      let certChainTab = await driver.findComponent(ON.id('tab_certchain'))
+      await certChainTab.click()
+      await driver.delayMs(200)
+      await expectInitialCountersUseExactZero(driver)
+
+      done()
+    })
+  })
+}
