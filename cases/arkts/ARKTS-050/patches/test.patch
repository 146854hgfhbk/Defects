+
+import { describe, it, expect } from '@ohos/hypium';
+import { Driver, ON, Component } from '@ohos.UiTest';
+import mediaLibrary from '@ohos.multimedia.mediaLibrary';
+import UIAbility from '@ohos.app.ability.UIAbility';
+import AbilityDelegatorRegistry from '@ohos.app.ability.abilityDelegatorRegistry';
+
+const BUNDLE = 'MultiMedia_';
+const TIME_OUT = 1000;
+
+let ability: UIAbility;
+let driver: Driver = Driver.create();
+let mediaTest: mediaLibrary.MediaLibrary = undefined;
+
+function padDate(value: number): string {
+  return value < 10 ? `0${value}` : `${value}`;
+}
+
+function formatDateAdded(seconds: number): string {
+  const date = new Date(seconds * 1000);
+  return `${date.getFullYear()}/${padDate(date.getMonth() + 1)}/${padDate(date.getDate())}`;
+}
+
+async function queryAssetById(id: number): Promise<mediaLibrary.FileAsset> {
+  let fileKeyObj = mediaLibrary.FileKey;
+  let fetchOp = {
+    selections: `${fileKeyObj.ID}=?`,
+    selectionArgs: [`${id}`],
+  };
+  let fetchFileResult = await mediaTest.getFileAssets(fetchOp);
+  let fileAssets = await fetchFileResult.getAllObject();
+  return fileAssets[0];
+}
+
+async function startAbility() {
+  let want = {
+    bundleName: 'ohos.samples.multimedia',
+    abilityName: 'MainAbility'
+  };
+  let abilityDelegator: AbilityDelegatorRegistry.AbilityDelegator = AbilityDelegatorRegistry.getAbilityDelegator();
+  abilityDelegator.startAbility(want, () => {
+  });
+  let monitor: AbilityDelegatorRegistry.AbilityMonitor = {
+    abilityName: 'MainAbility',
+    onAbilityCreate: () => {
+    }
+  };
+  let uiAbility = await abilityDelegator.waitAbilityMonitor(monitor, TIME_OUT);
+  ability = await abilityDelegator.getCurrentTopAbility();
+  mediaTest = mediaLibrary.getMediaLibrary(uiAbility.context);
+}
+
+export default function mediaItemDateDisplayTest() {
+  describe('mediaItemDateDisplayTest', function () {
+    it(`${BUNDLE}MediaItemDisplaysFileDateAdded`, 0, async () => {
+      await startAbility();
+      await driver.delayMs(1000);
+
+      let resourceManager = ability.context.resourceManager;
+      for (let i = 0; i < 4; i++) {
+        let allow = await driver.findComponent(ON.text(await resourceManager.getStringValue($r('app.string.allow'))));
+        if (allow === null) {
+          break;
+        }
+        await allow.click();
+        await driver.delayMs(500);
+      }
+
+      let publicPath = await mediaTest.getPublicDirectory(mediaLibrary.DirectoryType.DIR_DOCUMENTS);
+      let displayName = `date_added_regression_${Date.now()}.txt`;
+      let createdAsset = await mediaTest.createAsset(mediaLibrary.MediaType.FILE, displayName, publicPath);
+      let fileAsset = await queryAssetById(createdAsset.id);
+      if (fileAsset === undefined || fileAsset.dateAdded <= 0) {
+        expect().assertFail();
+      }
+      let expectedDate = formatDateAdded(fileAsset.dateAdded);
+
+      await driver.assertComponentExist(ON.id('mediaType0'));
+      let documents: Component = await driver.findComponent(ON.id('mediaType0'));
+      await documents.click();
+      await driver.delayMs(1500);
+
+      await driver.assertComponentExist(ON.text(expectedDate));
+      expect(true).assertTrue();
+    });
+  });
+}
