+import { describe, it, expect } from '@ohos/hypium';
+
+const BUNDLE = 'DistributedMusicPlayer_PlayerModelSeek_';
+
+type PlayerModelSlots = Record<string, Object | Function | number | boolean | undefined>;
+
+interface PlayerModelApi {
+  notifyPlayingStatus(isPlaying: boolean): void;
+  cancelTimer(): void;
+}
+
+class FakePlayer {
+  public currentTime: number;
+
+  constructor(currentTime: number) {
+    this.currentTime = currentTime;
+  }
+}
+
+async function loadPlayerModel(): Promise<PlayerModelApi> {
+  let module: ESObject = await import('../../../main/ets/model/PlayerModel');
+  return module.default as PlayerModelApi;
+}
+
+function slots(playerModel: PlayerModelApi): PlayerModelSlots {
+  return playerModel as Object as PlayerModelSlots;
+}
+
+function installProgressProbe(playerModel: PlayerModelApi, currentTime: number, progressEvents: Array<number>): Object | undefined {
+  let model = slots(playerModel);
+  let originalPlayer = model['player'] as Object | undefined;
+  model['player'] = new FakePlayer(currentTime);
+  model['intervalID'] = undefined;
+  model['statusChangedListener'] = ((isPlaying: boolean) => {
+    console.info(BUNDLE + 'status changed: ' + isPlaying);
+  }) as Function;
+  model['playingProgressListener'] = ((timeMs: number) => {
+    progressEvents.push(timeMs);
+  }) as Function;
+  return originalPlayer;
+}
+
+function restoreModel(playerModel: PlayerModelApi, originalPlayer: Object | undefined): void {
+  playerModel.cancelTimer();
+  let model = slots(playerModel);
+  model['player'] = originalPlayer;
+  model['isPlaying'] = false;
+  model['intervalID'] = undefined;
+}
+
+async function waitForProgressTick(): Promise<void> {
+  await new Promise<void>((resolve) => {
+    setTimeout(() => {
+      resolve();
+    }, 650);
+  });
+}
+
+export default function playerModelSeekProgressTest() {
+  describe('playerModelSeekProgressTest', () => {
+    it(BUNDLE + 'IgnoreMinusOneCurrentTime_001', 0, async () => {
+      let playerModel = await loadPlayerModel();
+      let progressEvents: Array<number> = [];
+      let originalPlayer = installProgressProbe(playerModel, -1, progressEvents);
+      try {
+        playerModel.notifyPlayingStatus(true);
+        await waitForProgressTick();
+        expect(progressEvents.length).assertEqual(0);
+      } finally {
+        restoreModel(playerModel, originalPlayer);
+      }
+    });
+
+    it(BUNDLE + 'ReportValidCurrentTime_002', 0, async () => {
+      let playerModel = await loadPlayerModel();
+      let progressEvents: Array<number> = [];
+      let originalPlayer = installProgressProbe(playerModel, 42, progressEvents);
+      try {
+        playerModel.notifyPlayingStatus(true);
+        await waitForProgressTick();
+        expect(progressEvents.length).assertLarger(0);
+        expect(progressEvents[0]).assertEqual(42);
+      } finally {
+        restoreModel(playerModel, originalPlayer);
+      }
+    });
+  });
+}
