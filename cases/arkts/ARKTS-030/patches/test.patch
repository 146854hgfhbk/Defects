+import { describe, it, expect } from '@ohos/hypium';
+import AbilityDelegatorRegistry from '@ohos.app.ability.abilityDelegatorRegistry';
+import { Driver, ON, Component } from '@ohos.UiTest';
+
+const BUNDLE_NAME: string = 'com.samples.languagebaseclasslibrary';
+const ABILITY_NAME: string = 'EntryAbility';
+const WAIT_START: number = 2400;
+const WAIT_PAGE: number = 1200;
+
+let delegator: AbilityDelegatorRegistry.AbilityDelegator =
+  AbilityDelegatorRegistry.getAbilityDelegator();
+
+async function findText(driver: Driver, text: string): Promise<Component | null> {
+  try {
+    let component = await driver.findComponent(ON.text(text));
+    if (component !== undefined && component !== null) {
+      return component;
+    }
+  } catch (error) {
+  }
+  return null;
+}
+
+async function findById(driver: Driver, id: string): Promise<Component | null> {
+  try {
+    let component = await driver.findComponent(ON.id(id));
+    if (component !== undefined && component !== null) {
+      return component;
+    }
+  } catch (error) {
+  }
+  return null;
+}
+
+async function isWithinDisplay(driver: Driver, component: Component | null): Promise<boolean> {
+  if (component === null) {
+    return false;
+  }
+  try {
+    let bounds = await component.getBounds();
+    let display = await driver.getDisplaySize();
+    return bounds.top >= 0 && bounds.bottom <= display.y && bounds.left >= 0 &&
+      bounds.right <= display.x;
+  } catch (error) {
+    return false;
+  }
+}
+
+export default function languageBaseDialogStyleTest() {
+  describe('LanguageBaseDialogStyleTestSuite', () => {
+    it('LanguageBaseDialog_BottomButtonsRemainReachable', 0, async () => {
+      const driver: Driver = Driver.create();
+      await delegator.startAbility({ bundleName: BUNDLE_NAME, abilityName: ABILITY_NAME });
+      await driver.delayMs(WAIT_START);
+
+      let manager = delegator.getAppContext().resourceManager;
+      let dequeText: string = await manager.getStringByName('deque');
+
+      let entry: Component | null = null;
+      try {
+        let list = await driver.findComponent(ON.type('List'));
+        let found = await list.scrollSearch(ON.text(dequeText));
+        if (found !== undefined && found !== null) {
+          entry = found;
+        }
+      } catch (error) {
+        entry = null;
+      }
+      if (entry === null) {
+        entry = await findText(driver, dequeText);
+      }
+      if (entry !== null) {
+        await entry.click();
+      }
+      await driver.delayMs(WAIT_PAGE);
+      await driver.assertComponentExist(ON.id('add'));
+      let addButton: Component = await driver.findComponent(ON.id('add'));
+      await addButton.click();
+      await driver.delayMs(WAIT_PAGE);
+      await driver.assertComponentExist(ON.id('add_age'));
+
+      let ageTrigger: Component = await driver.findComponent(ON.id('add_age'));
+      await ageTrigger.click();
+      await driver.delayMs(WAIT_PAGE);
+
+      let sure: Component | null = await findById(driver, 'add_sure');
+      let cancelText: string = await manager.getStringByName('cancel');
+      let cancel: Component | null = await findText(driver, cancelText);
+      let sureReachable: boolean = await isWithinDisplay(driver, sure);
+      let cancelReachable: boolean = await isWithinDisplay(driver, cancel);
+
+      let probe: string = 'sureExists=' + (sure !== null) + ';cancelExists=' + (cancel !== null) +
+        ';sureReachable=' + sureReachable + ';cancelReachable=' + cancelReachable;
+      console.info('LanguageBaseDialogProbe ' + probe);
+      let buttonsReachable: boolean = sureReachable && cancelReachable;
+      expect(buttonsReachable ? 'REACHABLE' : ('UNREACHABLE:' + probe)).assertEqual('REACHABLE');
+    });
+  });
+}
