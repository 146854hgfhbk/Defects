+import { describe, it, expect } from '@ohos/hypium';
+import { MemoryLruCache } from '@ohos/imageknife/src/main/ets/cache/MemoryLruCache';
+import { ImageKnifeData } from '@ohos/imageknife/src/main/ets/model/ImageKnifeData';
+
+function textData(length: number): ImageKnifeData {
+  return {
+    source: 'x'.repeat(length),
+    imageWidth: length,
+    imageHeight: 1
+  };
+}
+
+export default function MemoryLruCacheOversizeTest() {
+  describe('MemoryLruCacheOversizeTest', () => {
+    it('rejectsSingleItemAtMemoryLimit', 0, () => {
+      let memoryCache = new MemoryLruCache(3, 10);
+
+      memoryCache.put('small', textData(4));
+      memoryCache.put('limit', textData(10));
+
+      expect(memoryCache.get('small')?.source).assertEqual('xxxx');
+      expect(memoryCache.get('limit')).assertUndefined();
+      expect(memoryCache.size()).assertEqual(1);
+      expect(memoryCache.currentMemory).assertEqual(4);
+    });
+
+    it('keepsNormalStringCacheEntries', 0, () => {
+      let memoryCache = new MemoryLruCache(3, 10);
+
+      memoryCache.put('first', textData(4));
+      memoryCache.put('second', textData(5));
+
+      expect(memoryCache.get('first')?.source).assertEqual('xxxx');
+      expect(memoryCache.get('second')?.source).assertEqual('xxxxx');
+      expect(memoryCache.size()).assertEqual(2);
+      expect(memoryCache.currentMemory).assertEqual(9);
+    });
+  });
+}
