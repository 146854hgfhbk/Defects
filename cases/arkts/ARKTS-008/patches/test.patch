+import { describe, it, expect } from '@ohos/hypium';
+import { Driver, ON } from '@ohos.UiTest';
+
+const driver: Driver = Driver.create();
+
+export default function menuNavRouterTest() {
+  describe('MenuNavRouterTest', () => {
+    it('SecondLevelActivationKeepsPrimarySelection_001', 0, async (done: Function) => {
+      await driver.delayMs(1000);
+      await driver.assertComponentExist(ON.id('selectedLabelState'));
+      await driver.assertComponentExist(ON.id('selectedSecondLabelState'));
+      expect(await (await driver.findComponent(ON.id('selectedLabelState'))).getText())
+        .assertEqual('selectedLabel:ParentRoute');
+      expect(await (await driver.findComponent(ON.id('selectedSecondLabelState'))).getText())
+        .assertEqual('selectedSecondLabel:');
+
+      await driver.assertComponentExist(ON.text('SecondRoute'));
+      let secondRoute = await driver.findComponent(ON.text('SecondRoute'));
+      await secondRoute.click();
+      await driver.delayMs(500);
+
+      expect(await (await driver.findComponent(ON.id('selectedLabelState'))).getText())
+        .assertEqual('selectedLabel:ParentRoute');
+      expect(await (await driver.findComponent(ON.id('selectedSecondLabelState'))).getText())
+        .assertEqual('selectedSecondLabel:SecondRoute');
+      done();
+    });
+  });
+}
