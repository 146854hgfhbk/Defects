+
+import { describe, expect, it } from '@ohos/hypium';
+import TimeConversion from '../../../main/ets/util/TimeConversion';
+
+const MINUTE_SECONDS = 60;
+const TARGET_OFFSET_MS = 2 * MINUTE_SECONDS * 1000;
+const ACCEPTABLE_DRIFT_SECONDS = 30;
+
+export function TimeConversionTest() {
+  describe('TimeConversionTest', () => {
+    it('Date_to_millisecond_uses_calendar_month_and_day_of_month', 0, () => {
+      const targetDate = new Date(Date.now() + TARGET_OFFSET_MS);
+      const delaySeconds = TimeConversion.dateToMillisecond(
+        targetDate.getFullYear(),
+        targetDate.getMonth() + 1,
+        targetDate.getDate(),
+        targetDate.getHours(),
+        targetDate.getMinutes()
+      );
+
+      expect(delaySeconds >= MINUTE_SECONDS).assertTrue();
+      expect(delaySeconds <= (2 * MINUTE_SECONDS + ACCEPTABLE_DRIFT_SECONDS)).assertTrue();
+    });
+  });
+}
