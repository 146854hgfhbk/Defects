+import { describe, expect, it } from '@ohos/hypium';
+import { QueryStorageData } from '../../../main/ets/common/QueryStorageData';
+
+const INVALID_BUNDLE_NAME = 'invalid.bundle.name.for.storage.statistic.test';
+const STALE_LABEL = 'stale-label';
+
+interface AppNameResolver {
+  getAppNameSync: (labelId: number, bundleName: string, appName: string) => Promise<string>
+}
+
+async function resolveInvalidBundleName(): Promise<string> {
+  let query = new QueryStorageData();
+  let resolver = query as Object as AppNameResolver;
+  return await resolver.getAppNameSync(1, INVALID_BUNDLE_NAME, STALE_LABEL);
+}
+
+export default function QueryStorageDataFallbackTest() {
+  describe('QueryStorageDataFallbackTest', () => {
+    it('GetAppNameSync_InvalidBundle_FallsBackToBundleName_001', 0, async () => {
+      let appName = await resolveInvalidBundleName();
+      expect(appName).assertEqual(INVALID_BUNDLE_NAME);
+    });
+  });
+}
