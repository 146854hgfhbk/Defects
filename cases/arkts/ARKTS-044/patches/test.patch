+import { describe, it, expect } from '@ohos/hypium';
+import common from '@ohos.app.ability.common';
+import { Callback } from '@ohos.base';
+import { KvStoreModel } from '../../../main/ets/model/KvStoreModel';
+
+class TestKvStoreModel extends KvStoreModel {
+  createKvStore(_context: common.BaseContext, callback: Callback<void>): Promise<void> {
+    callback();
+    return Promise.resolve();
+  }
+}
+
+export default function kvStoreModelTest() {
+  describe('kvStoreModelTest', () => {
+    it('ignoresMissingKvStoreSubscription', 0, () => {
+      let model = new TestKvStoreModel();
+      let context = new Object() as common.UIAbilityContext;
+      let threw = false;
+      try {
+        model.setOnMessageReceivedListener(context, 'message', (_value: string) => {
+        });
+      } catch (err) {
+        threw = true;
+      }
+      expect(threw).assertEqual(false);
+    });
+  });
+}
