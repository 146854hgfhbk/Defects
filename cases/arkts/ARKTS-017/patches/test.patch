+import { describe, it, expect } from '@ohos/hypium';
+import FormAbility from '../../../main/ets/FormAbility/FormAbility';
+
+const BUNDLE = 'FormGame_FormAbility_';
+
+type FormAbilitySlots = Record<string, string | FakeStore | Function | undefined>;
+
+class FakeStore {
+  public sourceWord: string = '';
+  public targetWord: string = '';
+  public flushCount: number = 0;
+
+  putSync(key: string, value: string): void {
+    if (key === 'sourceWord') {
+      this.sourceWord = value;
+    }
+    if (key === 'targetWord') {
+      this.targetWord = value;
+    }
+  }
+
+  flushSync(): void {
+    this.flushCount++;
+  }
+}
+
+function slots(formAbility: FormAbility): FormAbilitySlots {
+  return formAbility as Object as FormAbilitySlots;
+}
+
+export default function formAbilityWordMoveTest() {
+  describe('formAbilityWordMoveTest', () => {
+    it(BUNDLE + 'SourceTapMovesLetterToTarget_001', 0, () => {
+      let formAbility = new FormAbility();
+      let store = new FakeStore();
+      let formSlots = slots(formAbility);
+      formSlots['storeDB'] = store;
+      formSlots['sourceWordStr'] = 'ABCD';
+      formSlots['targetWordStr'] = '    ';
+
+      formAbility.updateWordStr(0);
+
+      expect(formSlots['sourceWordStr']).assertEqual(' BCD');
+      expect(formSlots['targetWordStr']).assertEqual('A   ');
+      expect(store.sourceWord).assertEqual(' BCD');
+      expect(store.targetWord).assertEqual('A   ');
+      expect(store.flushCount).assertEqual(1);
+    });
+
+    it(BUNDLE + 'TargetTapMovesLetterBackToSource_002', 0, () => {
+      let formAbility = new FormAbility();
+      let store = new FakeStore();
+      let formSlots = slots(formAbility);
+      formSlots['storeDB'] = store;
+      formSlots['sourceWordStr'] = ' BCD';
+      formSlots['targetWordStr'] = 'A   ';
+
+      formAbility.updateWordStr(4);
+
+      expect(formSlots['sourceWordStr']).assertEqual('ABCD');
+      expect(formSlots['targetWordStr']).assertEqual('    ');
+      expect(store.sourceWord).assertEqual('ABCD');
+      expect(store.targetWord).assertEqual('    ');
+      expect(store.flushCount).assertEqual(1);
+    });
+  });
+}
