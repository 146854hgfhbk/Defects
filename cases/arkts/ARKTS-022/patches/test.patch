+import abilityDelegatorRegistry from '@ohos.app.ability.abilityDelegatorRegistry';
+import type common from '@ohos.app.ability.common';
+import { describe, expect, it } from '@ohos/hypium';
+import type camera from '@ohos.multimedia.camera';
+import { Constants } from '../../../main/ets/common/Constants';
+import { GlobalContext } from '../../../main/ets/common/GlobalContext';
+
+const BUNDLE_NAME = 'com.samples.camerajs';
+const MODULE_NAME = 'entry';
+const ABILITY_NAME = 'MainAbility';
+
+async function startMainAbility(): Promise<void> {
+  let delegator = abilityDelegatorRegistry.getAbilityDelegator();
+  GlobalContext.get().setCameraSettingContext(delegator.getAppContext() as common.UIAbilityContext);
+  await delegator.startAbility({
+    bundleName: BUNDLE_NAME,
+    moduleName: MODULE_NAME,
+    abilityName: ABILITY_NAME
+  });
+}
+
+function profile(width: number, height: number, frame: number): camera.VideoProfile {
+  return {
+    format: 1003,
+    size: {
+      width: width,
+      height: height
+    },
+    frameRateRange: {
+      min: frame,
+      max: frame
+    }
+  };
+}
+
+function buildCapabilities(): ESObject {
+  let previewProfile: camera.Profile = profile(1280, 720, Constants.VIDEO_FRAME_30);
+  let photoProfile: camera.Profile = profile(1280, 720, Constants.VIDEO_FRAME_30);
+  return {
+    previewProfiles: [previewProfile],
+    photoProfiles: [photoProfile],
+    videoProfiles: [
+      profile(1920, 1080, Constants.VIDEO_FRAME_30),
+      profile(1280, 720, Constants.VIDEO_FRAME_30)
+    ],
+    depthProfiles: [profile(1280, 720, Constants.VIDEO_FRAME_30)]
+  };
+}
+
+export default function CameraVideoProfileTest() {
+  describe('CameraVideoProfileTest', () => {
+    it('PhoneVideoMode_SelectsUsableVideoProfile_001', 0, async () => {
+      await startMainAbility();
+      AppStorage.setOrCreate<string>('deviceType', Constants.PHONE);
+      AppStorage.setOrCreate<number>('defaultAspectRatio', 16 / 9);
+
+      let cameraServiceModule: ESObject = await import('../../../main/ets/model/CameraService');
+      let cameraService: ESObject = cameraServiceModule.default;
+      cameraService.setCameraMode(1);
+      cameraService.switchProfiles(buildCapabilities());
+
+      let videoProfile: camera.VideoProfile = cameraService.videoProfileObj as camera.VideoProfile;
+      expect(videoProfile.size.width).assertEqual(1280);
+      expect(videoProfile.size.height).assertEqual(720);
+      expect(videoProfile.frameRateRange.max).assertEqual(Constants.VIDEO_FRAME_30);
+    });
+  });
+}
