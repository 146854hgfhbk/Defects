+import AbilityDelegatorRegistry from '@ohos.app.ability.abilityDelegatorRegistry';
+import common from '@ohos.app.ability.common';
+import Want from '@ohos.app.ability.Want';
+import { describe, it, expect } from '@ohos/hypium';
+import { logger } from '../util/Logger';
+
+const TAG = '[Sample_ArkTSDistributedCalc_UIAbilityContext]';
+const UIABILITY_CONTEXT_KEY = 'UIAbilityContext';
+
+function wait(time: number): Promise<void> {
+  return new Promise<void>((resolve: Function) => {
+    setTimeout(resolve, time);
+  });
+}
+
+export default function uiAbilityContextTest() {
+  let delegator = AbilityDelegatorRegistry.getAbilityDelegator();
+
+  describe('UIAbilityContextTest', () => {
+    it('MainAbilityStoresUIAbilityContext_001', 0, async (done: Function) => {
+      logger.info(TAG, 'MainAbilityStoresUIAbilityContext_001 begin');
+      let want: Want = {
+        bundleName: 'ohos.samples.distributedcalc',
+        abilityName: 'MainAbility'
+      };
+      delegator.startAbility(want, (err) => {
+        logger.info(TAG, `startAbility end err ${JSON.stringify(err)}`);
+      });
+      await wait(2000);
+
+      let context = AppStorage.get<common.UIAbilityContext>(UIABILITY_CONTEXT_KEY);
+      if (context === undefined) {
+        logger.error(TAG, `${UIABILITY_CONTEXT_KEY} was not stored in AppStorage`);
+        expect(false).assertTrue();
+        done();
+        return;
+      }
+      let localhost = context.resourceManager.getStringByNameSync('localhost');
+      expect(localhost.length > 0).assertTrue();
+      logger.info(TAG, 'MainAbilityStoresUIAbilityContext_001 end');
+      done();
+    });
+  });
+}
