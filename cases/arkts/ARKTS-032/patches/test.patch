+import { describe, expect, it } from '@ohos/hypium';
+import { Driver, ON } from '@ohos.UiTest';
+import AbilityDelegatorRegistry from '@ohos.app.ability.abilityDelegatorRegistry';
+import resourceManager from '@ohos.resourceManager';
+import router from '@ohos.router';
+
+const DELAY_TIME = 1000;
+let manager: resourceManager.ResourceManager;
+
+async function startApp(driver: Driver): Promise<void> {
+  let abilityDelegator = AbilityDelegatorRegistry.getAbilityDelegator();
+  await abilityDelegator.startAbility({
+    bundleName: 'ohos.samples.componentcollection',
+    moduleName: 'entry',
+    abilityName: 'MainAbility'
+  });
+  let context = await abilityDelegator.getAppContext();
+  manager = context.resourceManager;
+  await driver.delayMs(DELAY_TIME * 2);
+}
+
+async function clickId(driver: Driver, id: string): Promise<void> {
+  await driver.assertComponentExist(ON.id(id));
+  let component = await driver.findComponent(ON.id(id));
+  await component.click();
+  await driver.delayMs(DELAY_TIME);
+}
+
+async function revealId(driver: Driver, id: string): Promise<void> {
+  for (let i = 0; i < 5; i++) {
+    if (await driver.findComponent(ON.id(id))) {
+      return;
+    }
+    await driver.drag(500, 900, 500, 300, 500);
+    await driver.delayMs(DELAY_TIME);
+  }
+  await driver.assertComponentExist(ON.id(id));
+}
+
+async function waitForId(driver: Driver, id: string): Promise<void> {
+  for (let i = 0; i < 10; i++) {
+    if (await driver.findComponent(ON.id(id))) {
+      return;
+    }
+    await driver.delayMs(500);
+  }
+  await driver.assertComponentExist(ON.id(id));
+}
+
+async function openTabContentPage(driver: Driver): Promise<void> {
+  router.pushUrl({ url: 'pages/components/navigation/tabContentSample/TabContentSample' });
+  await driver.delayMs(DELAY_TIME);
+  await revealId(driver, 'tabcontent_001');
+}
+
+export default function TabContentSwitcherEnabledTest() {
+  describe('TabContentSwitcherEnabledTest', () => {
+    it('BottomTabSwitcherStillEnabledInSideMode_001', 0, async () => {
+      let driver = Driver.create();
+      await startApp(driver);
+      await openTabContentPage(driver);
+
+      await clickId(driver, 'tabcontent_001');
+      let sideButton = await driver.findComponent(ON.id('tabcontent_002'));
+      expect(await sideButton.isEnabled()).assertTrue();
+
+      await clickId(driver, 'tabcontent_002');
+      await revealId(driver, 'tabcontent_001');
+      let bottomSwitcher = await driver.findComponent(ON.id('tabcontent_001'));
+      expect(await bottomSwitcher.isEnabled()).assertTrue();
+
+      await bottomSwitcher.click();
+      await driver.delayMs(DELAY_TIME);
+      let sideButtonAfterClose = await driver.findComponent(ON.id('tabcontent_002'));
+      expect(await sideButtonAfterClose.isEnabled()).assertFalse();
+    });
+  });
+}
