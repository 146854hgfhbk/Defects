+import AbilityDelegatorRegistry from '@ohos.app.ability.abilityDelegatorRegistry';
+import { Driver, ON } from '@ohos.UiTest';
+import { describe, expect, it } from '@ohos/hypium';
+import inputMethod from '@ohos.inputMethod';
+
+const DRIVER = Driver.create();
+const FIRST_NAME = 'row27FirstContact';
+const FIRST_PHONE = '18800000001';
+const SECOND_NAME = 'row27SecondContact';
+const SECOND_PHONE = '18800000002';
+
+async function startMessageAbility(): Promise<void> {
+  let abilityDelegatorRegistry = AbilityDelegatorRegistry.getAbilityDelegator();
+  await abilityDelegatorRegistry.startAbility({
+    bundleName: 'ohos.samples.message',
+    abilityName: 'EntryAbility'
+  });
+  await DRIVER.delayMs(1000);
+  await DRIVER.assertComponentExist(ON.id('newContact'));
+}
+
+async function addContact(name: string, phone: string): Promise<void> {
+  let addBtn = await DRIVER.findComponent(ON.id('newContact'));
+  await addBtn.click();
+  await DRIVER.delayMs(800);
+
+  let nameInput = await DRIVER.findComponent(ON.id('nameInput'));
+  await nameInput.inputText(name);
+  inputMethod.getController().stopInputSession();
+  await DRIVER.delayMs(500);
+
+  let telInput = await DRIVER.findComponent(ON.id('telInput'));
+  await telInput.inputText(phone);
+  inputMethod.getController().stopInputSession();
+  await DRIVER.delayMs(500);
+
+  let confirm = await DRIVER.findComponent(ON.id('confirm'));
+  await confirm.click();
+  await DRIVER.delayMs(1000);
+  await DRIVER.assertComponentExist(ON.id(name));
+  await DRIVER.assertComponentExist(ON.text(phone));
+}
+
+async function countText(text: string): Promise<number> {
+  let components = await DRIVER.findComponents(ON.text(text));
+  if (components === undefined || components === null) {
+    return 0;
+  }
+  return components.length;
+}
+
+export default function messageDeleteRegressionTest() {
+  describe('MessageDeleteRegressionTest', function () {
+    it('DeleteShouldRemoveClickedContactAfterListInsert_001', 0, async function () {
+      await startMessageAbility();
+
+      await addContact(FIRST_NAME, FIRST_PHONE);
+      await addContact(SECOND_NAME, SECOND_PHONE);
+
+      let manageBtn = await DRIVER.findComponent(ON.id('manage'));
+      await manageBtn.click();
+      await DRIVER.delayMs(1000);
+
+      let deleteFirst = await DRIVER.findComponent(ON.id('delete_' + FIRST_NAME));
+      await deleteFirst.click();
+      await DRIVER.delayMs(1000);
+
+      expect(await countText(FIRST_PHONE)).assertEqual(0);
+      expect(await countText(SECOND_PHONE)).assertEqual(1);
+    })
+  })
+}
