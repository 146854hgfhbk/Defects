+import { describe, expect, it } from '@ohos/hypium';
+import { OptLayoutChatView } from '@ohos/chatlist/src/main/ets/view/OptLayoutChatView';
+import { ChatContact, ChatModel } from '@ohos/chatlist/src/main/ets/viewmodel/MsgBase';
+
+interface ChatItemHolder {
+  chatItem: ChatModel;
+}
+
+interface ReuseInvoker {
+  call(holder: ChatItemHolder, params: Record<string, Object>): void;
+}
+
+interface OptLayoutPrototype {
+  aboutToReuse?: ReuseInvoker;
+}
+
+interface OptLayoutConstructor {
+  prototype: OptLayoutPrototype;
+}
+
+class ReuseParams {
+  chatItem: ChatModel;
+
+  constructor(chatItem: ChatModel) {
+    this.chatItem = chatItem;
+  }
+}
+
+class ChatItemProbe implements ChatItemHolder {
+  chatItem: ChatModel = makeChatItem('row90-user-old', 'row90-message-old', 1);
+}
+
+function makeChatItem(userName: string, lastMsg: string, unreadMsgCount: number): ChatModel {
+  return new ChatModel(new ChatContact(userName, userName, ''), lastMsg, '12:00', unreadMsgCount);
+}
+
+function getOptLayoutReuseMethod(): ReuseInvoker | undefined {
+  let constructorRef = OptLayoutChatView as Object as OptLayoutConstructor;
+  return constructorRef.prototype.aboutToReuse;
+}
+
+export default function optLayoutChatViewReuseTest() {
+  describe('OptLayoutChatViewReuseTest', () => {
+    it('about_to_reuse_should_replace_rendered_chat_item_001', 0, () => {
+      let reuseMethod = getOptLayoutReuseMethod();
+      expect(reuseMethod !== undefined).assertTrue();
+      if (reuseMethod === undefined) {
+        return;
+      }
+
+      let probe = new ChatItemProbe();
+      let nextItem = makeChatItem('row90-user-next', 'row90-message-next', 9);
+
+      reuseMethod.call(probe, new ReuseParams(nextItem) as Object as Record<string, Object>);
+
+      expect(probe.chatItem.user.userName as string).assertEqual('row90-user-next');
+      expect(probe.chatItem.lastMsg).assertEqual('row90-message-next');
+      expect(probe.chatItem.unreadMsgCount).assertEqual(9);
+    });
+
+    it('chat_model_should_preserve_list_item_fields_002', 0, () => {
+      let chatItem = makeChatItem('row90-user-stable', 'row90-message-stable', 3);
+
+      expect(chatItem.user.userName as string).assertEqual('row90-user-stable');
+      expect(chatItem.lastMsg).assertEqual('row90-message-stable');
+      expect(chatItem.unreadMsgCount).assertEqual(3);
+    });
+  });
+}
