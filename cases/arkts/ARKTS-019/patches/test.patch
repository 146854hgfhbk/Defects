+import { describe, it, expect } from '@ohos/hypium';
+
+const BUNDLE = 'DistributedMusicPlayer_PlayerModel_';
+
+type PlayerModelSlots = Record<string, Object | Function | number | boolean | undefined>;
+
+interface PlayerModelApi {
+  pause(): void;
+  stop(): void;
+  seek(ms: number): void;
+}
+
+class FakePlayer {
+  public pauseCount: number = 0;
+  public stopCount: number = 0;
+  public seekValue: number = -1;
+  public state: string = 'play';
+  public currentTime: number = 36;
+  public duration: number = 3600;
+  public src: string = 'fd://row1';
+
+  pause(): void {
+    this.pauseCount++;
+  }
+
+  stop(): void {
+    this.stopCount++;
+  }
+
+  seek(ms: number): void {
+    this.seekValue = ms;
+  }
+
+  on(eventName: string, callback: Function): void {
+  }
+}
+
+async function loadPlayerModel(): Promise<PlayerModelApi> {
+  let module: ESObject = await import('../../../main/ets/model/PlayerModel');
+  return module.default as PlayerModelApi;
+}
+
+function slots(playerModel: PlayerModelApi): PlayerModelSlots {
+  return playerModel as Object as PlayerModelSlots;
+}
+
+function withoutThrow(action: () => void): boolean {
+  try {
+    action();
+    return true;
+  } catch (error) {
+    console.info(BUNDLE + 'unexpected exception: ' + JSON.stringify(error));
+    return false;
+  }
+}
+
+function prepareModel(playerModel: PlayerModelApi, player: Object | undefined): void {
+  let model = slots(playerModel);
+  model['player'] = player;
+  model['isPlaying'] = true;
+  model['intervalID'] = undefined;
+  model['statusChangedListener'] = ((isPlaying: boolean) => {
+    console.info(BUNDLE + 'status changed: ' + isPlaying);
+  }) as Function;
+  model['playingProgressListener'] = ((currentTime: number) => {
+    console.info(BUNDLE + 'progress: ' + currentTime);
+  }) as Function;
+}
+
+function restoreModel(playerModel: PlayerModelApi, player: Object | undefined): void {
+  let model = slots(playerModel);
+  model['player'] = player;
+  model['isPlaying'] = false;
+  model['intervalID'] = undefined;
+}
+
+export default function playerModelLifecycleTest() {
+  describe('playerModelLifecycleTest', () => {
+    it(BUNDLE + 'ReleasedPlayerDoesNotCrash_001', 0, async () => {
+      let playerModel = await loadPlayerModel();
+      let originalPlayer = slots(playerModel)['player'] as Object | undefined;
+      try {
+        prepareModel(playerModel, undefined);
+        expect(withoutThrow(() => {
+          playerModel.pause();
+        })).assertTrue();
+
+        prepareModel(playerModel, undefined);
+        expect(withoutThrow(() => {
+          playerModel.stop();
+        })).assertTrue();
+
+        prepareModel(playerModel, undefined);
+        expect(withoutThrow(() => {
+          playerModel.seek(1200);
+        })).assertTrue();
+      } finally {
+        restoreModel(playerModel, originalPlayer);
+      }
+    });
+
+    it(BUNDLE + 'FakePlayerStillReceivesCommands_002', 0, async () => {
+      let playerModel = await loadPlayerModel();
+      let originalPlayer = slots(playerModel)['player'] as Object | undefined;
+      let fakePlayer = new FakePlayer();
+      try {
+        prepareModel(playerModel, fakePlayer);
+        playerModel.pause();
+        expect(fakePlayer.pauseCount).assertEqual(1);
+
+        prepareModel(playerModel, fakePlayer);
+        playerModel.stop();
+        expect(fakePlayer.stopCount).assertEqual(1);
+
+        prepareModel(playerModel, fakePlayer);
+        playerModel.seek(2500);
+        expect(fakePlayer.seekValue).assertEqual(2500);
+      } finally {
+        restoreModel(playerModel, originalPlayer);
+      }
+    });
+  });
+}
