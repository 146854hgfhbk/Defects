+import { describe, it, expect } from '@ohos/hypium';
+import { calc } from '../../../main/ets/model/Calculator';
+
+export default function calculatorLogicTest() {
+  describe('calculatorLogicTest', () => {
+    it('operatorPrecedenceInChainedExpression_001', 0, () => {
+      expect(calc('1+2*3*4')).assertEqual('25');
+      expect(calc('10-2*3*2')).assertEqual('-2');
+    });
+  });
+}
