+import { describe, expect, it } from '@ohos/hypium';
+import { Driver, ON } from '@ohos.UiTest';
+import AbilityDelegatorRegistry from '@ohos.app.ability.abilityDelegatorRegistry';
+import fs from '@ohos.file.fs';
+
+const BUNDLE_NAME = 'com.samples.filemanager';
+const ROOT_SANDBOX = '/data/storage/el2/base/haps/';
+const TEST_NAME_PREFIX = 'sameNameRuntime';
+const UI_DELAY_MS = 600;
+const PAGE_READY_RETRY = 10;
+
+async function createItemByUi(driver: Driver, buttonId: string, name: string): Promise<void> {
+  const createButton = await driver.findComponent(ON.id(buttonId));
+  await createButton.click();
+  await driver.delayMs(UI_DELAY_MS);
+  await driver.assertComponentExist(ON.id('input'));
+  const input = await driver.findComponent(ON.id('input'));
+  await input.inputText(name);
+  await driver.delayMs(UI_DELAY_MS);
+  await driver.assertComponentExist(ON.id('promise'));
+  const confirm = await driver.findComponent(ON.id('promise'));
+  await confirm.click();
+  await driver.delayMs(UI_DELAY_MS);
+}
+
+function removePathIfExists(path: string): void {
+  try {
+    if (fs.accessSync(path)) {
+      const stat = fs.statSync(path);
+      if (stat.isDirectory()) {
+        fs.rmdirSync(path);
+      } else {
+        fs.unlinkSync(path);
+      }
+    }
+  } catch (err) {
+  }
+}
+
+async function startMainAbility(driver: Driver): Promise<void> {
+  await AbilityDelegatorRegistry.getAbilityDelegator().startAbility({
+    bundleName: BUNDLE_NAME,
+    abilityName: 'MainAbility'
+  });
+  await driver.delayMs(UI_DELAY_MS);
+}
+
+async function tapPermissionIfPresent(driver: Driver): Promise<void> {
+  const allowButton = await driver.findComponent(ON.text('允许'));
+  if (allowButton != null) {
+    await allowButton.click();
+    await driver.delayMs(UI_DELAY_MS);
+  }
+  const permitButton = await driver.findComponent(ON.text('permit'));
+  if (permitButton != null) {
+    await permitButton.click();
+    await driver.delayMs(UI_DELAY_MS);
+  }
+}
+
+async function openMyPhonePage(driver: Driver): Promise<void> {
+  for (let i = 0; i < PAGE_READY_RETRY; i++) {
+    await tapPermissionIfPresent(driver);
+    if (await driver.findComponent(ON.id('ListItem5')) != null) {
+      break;
+    }
+    await driver.delayMs(UI_DELAY_MS);
+  }
+  await driver.assertComponentExist(ON.id('ListItem5'));
+  const myPhone = await driver.findComponent(ON.id('ListItem5'));
+  await myPhone.click();
+  await driver.delayMs(UI_DELAY_MS);
+  await driver.assertComponentExist(ON.id('makeDirectory'));
+  await driver.assertComponentExist(ON.id('makeFile'));
+}
+
+export default function myPhoneCreateSameNameTest() {
+  describe('MyPhoneCreateSameNameTest', () => {
+    it('creates_file_with_txt_suffix_when_directory_has_same_name', 0, async () => {
+      const uniqueName = `${TEST_NAME_PREFIX}${Date.now()}`;
+      const directoryPath = `${ROOT_SANDBOX}${uniqueName}`;
+      const filePath = `${ROOT_SANDBOX}${uniqueName}.txt`;
+      removePathIfExists(filePath);
+      removePathIfExists(directoryPath);
+
+      const driver = Driver.create();
+      await startMainAbility(driver);
+      await openMyPhonePage(driver);
+      await createItemByUi(driver, 'makeDirectory', uniqueName);
+      await driver.assertComponentExist(ON.text(uniqueName));
+      await createItemByUi(driver, 'makeFile', uniqueName);
+
+      expect(fs.accessSync(directoryPath)).assertTrue();
+      expect(fs.accessSync(filePath)).assertTrue();
+      await driver.assertComponentExist(ON.text(`${uniqueName}.txt`));
+
+      removePathIfExists(filePath);
+      removePathIfExists(directoryPath);
+    });
+  });
+}
