+import { describe, it, expect } from '@ohos/hypium';
+import AbilityDelegatorRegistry from '@ohos.app.ability.abilityDelegatorRegistry';
+import common from '@ohos.app.ability.common';
+import window from '@ohos.window';
+import { UIContext } from '@ohos.arkui.UIContext';
+import componentUtils from '@ohos.arkui.componentUtils';
+import { Driver, ON, Component, MatchPattern } from '@ohos.UiTest';
+
+const BUNDLE_NAME: string = 'ohos.samples.componentcollection';
+const ABILITY_NAME: string = 'MainAbility';
+const DELAY_BUTTON_ID: string = 'animate_btn_delay';
+const WAIT_START: number = 2400;
+const WAIT_PAGE: number = 1200;
+const SAMPLE_INTERVAL: number = 1200;
+const SAMPLE_LATE_MID: number = 1200;
+const SAMPLE_LATE_END: number = 1800;
+const ROTATED_MIN_ANGLE: number = 45;
+
+let delegator: AbilityDelegatorRegistry.AbilityDelegator =
+  AbilityDelegatorRegistry.getAbilityDelegator();
+
+function sleep(ms: number): Promise<void> {
+  return new Promise<void>((resolve: () => void) => {
+    setTimeout(resolve, ms);
+  });
+}
+
+function componentReadable(context: UIContext): boolean {
+  try {
+    let info: componentUtils.ComponentInfo =
+      context.getComponentUtils().getRectangleById(DELAY_BUTTON_ID);
+    return info !== undefined && info !== null;
+  } catch (error) {
+    return false;
+  }
+}
+
+async function resolveAppUIContext(): Promise<UIContext> {
+  for (let index = 0; index < 20; index++) {
+    let baseContext: common.Context = delegator.getAppContext();
+    try {
+      let ability = await delegator.getCurrentTopAbility();
+      if (ability !== undefined && ability !== null) {
+        baseContext = ability.context;
+      }
+    } catch (error) {
+    }
+    try {
+      let topWindow: window.Window = await window.getLastWindow(baseContext);
+      let uiContext: UIContext = topWindow.getUIContext();
+      if (componentReadable(uiContext)) {
+        return uiContext;
+      }
+    } catch (error) {
+    }
+    await sleep(250);
+  }
+  throw new Error('App UIContext containing ' + DELAY_BUTTON_ID + ' was not resolved');
+}
+
+function readDelayButtonAngle(uiContext: UIContext): number {
+  try {
+    let info: componentUtils.ComponentInfo =
+      uiContext.getComponentUtils().getRectangleById(DELAY_BUTTON_ID);
+    return info.rotate.angle;
+  } catch (error) {
+    let angle: number = -1000;
+    uiContext.runScopedTask(() => {
+      let info: componentUtils.ComponentInfo = componentUtils.getRectangleById(DELAY_BUTTON_ID);
+      angle = info.rotate.angle;
+    });
+    return angle;
+  }
+}
+
+export default function animateToAnimationFixTest() {
+  describe('AnimateToAnimationFixTestSuite', () => {
+    it('AnimateTo_Delay_Button_Rotates_Before_Delay_Elapses', 0, async () => {
+      const driver: Driver = Driver.create();
+      await delegator.startAbility({ bundleName: BUNDLE_NAME, abilityName: ABILITY_NAME });
+      await driver.delayMs(WAIT_START);
+      await driver.assertComponentExist(ON.id('tabBar2'));
+      let animationsTab: Component = await driver.findComponent(ON.id('tabBar2'));
+      await animationsTab.click();
+      await driver.delayMs(WAIT_PAGE);
+      await driver.assertComponentExist(ON.text('animateTo', MatchPattern.CONTAINS));
+      let animateToEntry: Component =
+        await driver.findComponent(ON.text('animateTo', MatchPattern.CONTAINS));
+      await animateToEntry.click();
+      await driver.delayMs(WAIT_PAGE);
+      await driver.assertComponentExist(ON.id(DELAY_BUTTON_ID));
+
+      let uiContext: UIContext = await resolveAppUIContext();
+      let beforeAngle: number = readDelayButtonAngle(uiContext);
+
+      let delayButton: Component = await driver.findComponent(ON.id(DELAY_BUTTON_ID));
+      await delayButton.click();
+
+      await driver.delayMs(SAMPLE_INTERVAL);
+      let duringAngle1: number = readDelayButtonAngle(uiContext);
+      await driver.delayMs(SAMPLE_INTERVAL);
+      let duringAngle2: number = readDelayButtonAngle(uiContext);
+      await driver.delayMs(SAMPLE_LATE_MID);
+      let lateMidAngle: number = readDelayButtonAngle(uiContext);
+      await driver.delayMs(SAMPLE_LATE_END);
+      let lateEndAngle: number = readDelayButtonAngle(uiContext);
+
+      let probe: string = 'before=' + beforeAngle + ';during1=' + duringAngle1 +
+        ';during2=' + duringAngle2 + ';lateMid=' + lateMidAngle + ';lateEnd=' + lateEndAngle;
+      console.info('AnimateToDelayProbe ' + probe);
+      let rotatesBeforeDelayElapses: boolean =
+        Math.abs(duringAngle1) >= ROTATED_MIN_ANGLE &&
+        Math.abs(duringAngle2) >= ROTATED_MIN_ANGLE;
+      expect(rotatesBeforeDelayElapses ? 'ROTATED_EARLY' : ('WAITED:' + probe))
+        .assertEqual('ROTATED_EARLY');
+    });
+  });
+}
