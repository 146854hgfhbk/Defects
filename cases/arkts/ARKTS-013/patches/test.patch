+import { describe, it, expect } from '@ohos/hypium';
+import { Browser } from '../../../main/ets/model/Browser';
+
+class LoadUrlProbe {
+  public requests: string[] = [];
+
+  loadUrl(url: string) {
+    this.requests.push(url);
+  }
+}
+
+export default function browserUrlHandlingTest() {
+  describe('BrowserUrlHandlingTest', () => {
+    it('LoadUrlDoesNotDuplicateHttpsScheme_001', 0, () => {
+      let browser = new Browser();
+      let probe = new LoadUrlProbe();
+      (browser.webControllerArray[0] as any).controller = probe;
+
+      browser.loadUrl('example.com/path');
+      browser.loadUrl('https://example.com/path');
+
+      expect(probe.requests[0]).assertEqual('https://example.com/path');
+      expect(probe.requests[1]).assertEqual('https://example.com/path');
+    })
+  })
+}
