+import { describe, it, expect } from '@ohos/hypium';
+import { deviceInfo } from '@kit.BasicServicesKit';
+import { Timer } from '../../../main/ets/pages/timer/Timer';
+import Logger from '../util/Logger';
+
+const TAG = 'TimerTest';
+const WAIT_TIMEOUT_MS = 800;
+
+function wait(time: number): Promise<void> {
+  return new Promise<void>((resolve: Function) => {
+    setTimeout(resolve, time);
+  });
+}
+
+async function assertCalendarTimeoutCleared(action: 'pause' | 'reset'): Promise<void> {
+  let timer: Timer = new Timer(undefined, new LocalStorage());
+  let fired = false;
+  let timeoutId = setTimeout(() => {
+    fired = true;
+  }, 200);
+  Reflect.set(timer, 'calendarTimerId', timeoutId);
+  Reflect.set(timer, 'reminderId', 1);
+  try {
+    try {
+      if (action === 'pause') {
+        await timer.pause();
+      } else {
+        await timer.reset(true);
+      }
+    } catch (err) {
+      Logger.info(TAG, `${action} threw: ${JSON.stringify(err)}`);
+    }
+    await wait(WAIT_TIMEOUT_MS);
+    expect(fired).assertFalse();
+  } finally {
+    clearTimeout(timeoutId);
+  }
+}
+
+export default function timerTest() {
+  describe('TimerTest', () => {
+    it('NonDefaultPauseClearsCalendarTimeout_001', 0, async (done: Function) => {
+      Logger.info(TAG, `deviceType=${deviceInfo.deviceType}`);
+      if (deviceInfo.deviceType === 'default') {
+        Logger.info(TAG, 'skip non-default pause assertion on default device');
+        done();
+        return;
+      }
+      await assertCalendarTimeoutCleared('pause');
+      done();
+    });
+
+    it('NonDefaultResetClearsCalendarTimeout_001', 0, async (done: Function) => {
+      Logger.info(TAG, `deviceType=${deviceInfo.deviceType}`);
+      if (deviceInfo.deviceType === 'default') {
+        Logger.info(TAG, 'skip non-default reset assertion on default device');
+        done();
+        return;
+      }
+      await assertCalendarTimeoutCleared('reset');
+      done();
+    });
+  });
+}
