+import { describe, it, expect } from '@ohos/hypium';
+import remoteDeviceModel from '../../../main/ets/model/RemoteDeviceModel';
+import { setGlobalObject } from '../../../main/ets/common/GlobalThis';
+
+const DEVICE_TYPE_NAME: string = 'deviceType';
+const AUTH_FORM_NAME: string = 'authForm';
+const IS_ONLINE_NAME: string = 'isOnline';
+const IS_TRUSTED_NAME: string = 'isTrusted';
+const RANGE_NAME: string = 'range';
+const FILTER_NOT_FOUND: number = -10000;
+
+class FakeDeviceManager {
+  public lastFilterJson: string = '';
+  public discoveryCallCount: number = 0;
+  public registeredEvents: Array<string> = [];
+
+  on(event: string, callback: Function): void {
+    this.registeredEvents.push(event);
+  }
+
+  off(event: string): void {
+  }
+
+  startDeviceDiscovery(info: Object, filterJson?: string): void {
+    this.discoveryCallCount++;
+    if (filterJson !== undefined) {
+      this.lastFilterJson = filterJson;
+    }
+  }
+}
+
+function configureSelectedFilterOptions(): void {
+  let filterOptions = new Map<string, number>();
+  filterOptions.set(DEVICE_TYPE_NAME, 0);
+  filterOptions.set(AUTH_FORM_NAME, 0);
+  filterOptions.set(IS_ONLINE_NAME, 1);
+  filterOptions.set(IS_TRUSTED_NAME, 0);
+  filterOptions.set(RANGE_NAME, 0);
+
+  setGlobalObject('deviceTypeName', DEVICE_TYPE_NAME);
+  setGlobalObject('authFormName', AUTH_FORM_NAME);
+  setGlobalObject('isOnlineName', IS_ONLINE_NAME);
+  setGlobalObject('isTrustedName', IS_TRUSTED_NAME);
+  setGlobalObject('rangeName', RANGE_NAME);
+  setGlobalObject('filterOptions', filterOptions);
+}
+
+function getFilterValue(filterJson: string, filterType: string): number {
+  let parsed: ESObject = JSON.parse(filterJson);
+  let filters: Array<ESObject> = parsed.filters;
+  for (let index = 0; index < filters.length; index++) {
+    if (filters[index].type === filterType) {
+      return filters[index].value as number;
+    }
+  }
+  return FILTER_NOT_FOUND;
+}
+
+function getFilterCount(filterJson: string): number {
+  let parsed: ESObject = JSON.parse(filterJson);
+  let filters: Array<ESObject> = parsed.filters;
+  return filters.length;
+}
+
+export default function deviceDiscoveryFilterTest() {
+  describe('DeviceDiscoveryFilterTest', () => {
+    it('selectedFilterOptionsShouldBeForwardedToDeviceDiscovery', 0, () => {
+      configureSelectedFilterOptions();
+
+      let fakeDeviceManager = new FakeDeviceManager();
+      let model: ESObject = remoteDeviceModel;
+      model.deviceManager = fakeDeviceManager;
+      model.startDeviceDiscovery();
+
+      expect(fakeDeviceManager.discoveryCallCount).assertEqual(1);
+      expect(fakeDeviceManager.lastFilterJson.length > 0).assertTrue();
+      expect(getFilterCount(fakeDeviceManager.lastFilterJson)).assertEqual(1);
+      expect(getFilterValue(fakeDeviceManager.lastFilterJson, 'credible')).assertEqual(1);
+      expect(getFilterValue(fakeDeviceManager.lastFilterJson, 'deviceType')).assertEqual(FILTER_NOT_FOUND);
+      expect(getFilterValue(fakeDeviceManager.lastFilterJson, 'authForm')).assertEqual(FILTER_NOT_FOUND);
+      expect(getFilterValue(fakeDeviceManager.lastFilterJson, 'isTrusted')).assertEqual(FILTER_NOT_FOUND);
+      expect(getFilterValue(fakeDeviceManager.lastFilterJson, 'range')).assertEqual(FILTER_NOT_FOUND);
+    });
+  });
+}
