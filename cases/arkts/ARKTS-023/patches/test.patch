+import { describe, it, expect } from '@ohos/hypium';
+import { Driver, ON, Component } from '@ohos.UiTest';
+import AbilityDelegatorRegistry from '@ohos.app.ability.abilityDelegatorRegistry';
+import hilog from '@ohos.hilog';
+
+const TAG = '[Sample_AppAccountManagerRegression]';
+const DOMAIN = 0xF811;
+const BUNDLE = 'AppAccountManagerRegression_';
+const WAIT_MS = 1000;
+
+let driver: Driver = Driver.create();
+
+async function startEntryAbility() {
+  let abilityDelegator = AbilityDelegatorRegistry.getAbilityDelegator();
+  await abilityDelegator.startAbility({
+    bundleName: 'ohos.samples.etsappaccountmanager',
+    abilityName: 'EntryAbility'
+  });
+  await driver.delayMs(WAIT_MS);
+}
+
+async function allowInputMethodPermissionIfPresent() {
+  await driver.delayMs(WAIT_MS);
+  try {
+    let confirmButton: Component = await driver.findComponent(ON.id('Paf.Permission.button_confirm'));
+    await confirmButton.click();
+    await driver.delayMs(WAIT_MS);
+  } catch (error) {
+    hilog.info(DOMAIN, TAG, `No input method permission page: ${JSON.stringify(error)}`);
+  }
+}
+
+async function clickById(id: string) {
+  await allowInputMethodPermissionIfPresent();
+  try {
+    await driver.assertComponentExist(ON.id(id));
+  } catch (error) {
+    await allowInputMethodPermissionIfPresent();
+    await driver.assertComponentExist(ON.id(id));
+  }
+  let component: Component = await driver.findComponent(ON.id(id));
+  await component.click();
+  await driver.delayMs(WAIT_MS);
+}
+
+export default function appAccountManagerRegressionTest() {
+  describe('AppAccountManagerRegression', function () {
+    it(BUNDLE + 'RegisterUsernameRejectsSpecialCharacters_001', 0, async () => {
+      hilog.info(DOMAIN, TAG, BUNDLE + 'RegisterUsernameRejectsSpecialCharacters_001 begin');
+      await startEntryAbility();
+      await allowInputMethodPermissionIfPresent();
+      await clickById('MusicApp');
+      await clickById('register');
+
+      await allowInputMethodPermissionIfPresent();
+      await driver.assertComponentExist(ON.id('Register1'));
+      let usernameInput: Component = await driver.findComponent(ON.id('Register1'));
+      await usernameInput.inputText('bug$name316');
+      await driver.delayMs(WAIT_MS);
+      await allowInputMethodPermissionIfPresent();
+      await driver.assertComponentExist(ON.id('Register1'));
+      usernameInput = await driver.findComponent(ON.id('Register1'));
+      await usernameInput.inputText('bug$name316');
+      await driver.delayMs(WAIT_MS);
+
+      let usernameValue = await usernameInput.getText();
+      if (usernameValue.indexOf('$') >= 0) {
+        hilog.info(DOMAIN, TAG, `username still contains rejected character: ${usernameValue}`);
+        expect().assertFail();
+      }
+      hilog.info(DOMAIN, TAG, BUNDLE + 'RegisterUsernameRejectsSpecialCharacters_001 end');
+    });
+  });
+}
