+import { describe, it, expect } from '@ohos/hypium';
+import { Driver, ON } from '@ohos.UiTest';
+import { Logger } from '../../../main/ets/common/Logger';
+
+const TAG = '[Sample_RPC_FlexListLayout]';
+
+export default function flexListLayoutTest() {
+  describe('FlexListLayoutTest', () => {
+    it('RPC_FlexListLayout_001', 0, async () => {
+      let driver = await Driver.create();
+      await driver.delayMs(1000);
+
+      await driver.assertComponentExist(ON.text('FlexListLayoutAnchor'));
+      await driver.assertComponentExist(ON.text('LayoutCategory'));
+      await driver.assertComponentExist(ON.id('amount'));
+
+      let anchor = await driver.findComponent(ON.id('layoutAnchor'));
+      let category = await driver.findComponent(ON.text('LayoutCategory'));
+      let amount = await driver.findComponent(ON.id('amount'));
+      let anchorBounds = await anchor.getBounds();
+      let categoryBounds = await category.getBounds();
+      let amountBounds = await amount.getBounds();
+      let categoryCenterY = (categoryBounds.top + categoryBounds.bottom) / 2;
+      let amountCenterY = (amountBounds.top + amountBounds.bottom) / 2;
+      let rowCenterGap = Math.abs(categoryCenterY - amountCenterY);
+      let topGap = categoryBounds.top - anchorBounds.bottom;
+
+      Logger.info(TAG, `rowCenterGap=${rowCenterGap}, topGap=${topGap}`);
+      expect(rowCenterGap).assertLess(12);
+      expect(topGap).assertLess(12);
+    })
+  })
+}
