+import { describe, it, expect } from '@ohos/hypium';
+import ContactDataSource from '../../../main/ets/common/BasicDataSource';
+import Contact from '../../../main/ets/model/Contact';
+
+const MALE: number = 0;
+const FEMALE: number = 1;
+
+export default function contactDataSourceTest() {
+  describe('ContactDataSourceTest', () => {
+    it('DistributedRdb_UpdateGender_001', 0, () => {
+      const contactId = 1001;
+      const initialRows: Array<Contact> = [
+        new Contact(contactId, 'Alex', MALE, '138****0001', 30, 'same contact')
+      ];
+      const refreshedRows: Array<Contact> = [
+        new Contact(contactId, 'Alex', FEMALE, '138****0001', 30, 'same contact')
+      ];
+      const source = new ContactDataSource(initialRows);
+
+      source.replaceDataArray(refreshedRows);
+
+      expect(source.totalCount()).assertEqual(1);
+      expect(source.getData(0).id).assertEqual(contactId);
+      expect(source.getData(0).gender).assertEqual(FEMALE);
+    });
+  });
+}
