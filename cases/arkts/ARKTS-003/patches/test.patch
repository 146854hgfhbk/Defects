+import AbilityDelegatorRegistry from '@ohos.app.ability.abilityDelegatorRegistry';
+import { describe, it, expect } from '@ohos/hypium';
+import { Driver, ON } from '@ohos.UiTest';
+import window from '@ohos.window';
+
+const BUNDLE: string = 'FlipClock_';
+const WAIT_TIME: number = 1000;
+
+let driver: Driver = Driver.create();
+let abilityDelegator = AbilityDelegatorRegistry.getAbilityDelegator();
+
+async function startTestAbility(): Promise<window.Window> {
+  await abilityDelegator.startAbility({
+    bundleName: 'ohos.samples.flipclock',
+    abilityName: 'TestAbility'
+  });
+  await driver.delayMs(WAIT_TIME * 2);
+  let ability = await abilityDelegator.getCurrentTopAbility();
+  return await window.getLastWindow(ability.context);
+}
+
+export default function keepScreenOnTest(): void {
+  describe('KeepScreenOnTest', () => {
+    it(BUNDLE + 'KeepScreenOn_001', 0, async () => {
+      let testWindow = await startTestAbility();
+      await testWindow.setWindowKeepScreenOn(false);
+      expect(testWindow.getWindowProperties().isKeepScreenOn).assertFalse();
+
+      await driver.assertComponentExist(ON.id('screenLight'));
+      let keepScreenSwitch = await driver.findComponent(ON.id('screenLight'));
+      await keepScreenSwitch.click();
+      await driver.delayMs(WAIT_TIME * 2);
+
+      expect(testWindow.getWindowProperties().isKeepScreenOn).assertTrue();
+    })
+  })
+}
