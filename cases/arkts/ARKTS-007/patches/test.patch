+import AbilityDelegatorRegistry from '@ohos.app.ability.abilityDelegatorRegistry';
+import { describe, it, expect } from '@ohos/hypium';
+import { Component, Driver, ON } from '@ohos.UiTest';
+
+const BUNDLE: string = 'AppAccountManager_';
+const WAIT_TIME: number = 1000;
+const EMAIL: string = 'route15@qq.com';
+const SIGNATURE: string = 'route15-sign';
+
+let driver: Driver = Driver.create();
+
+async function startTestAbility(): Promise<void> {
+  let abilityDelegator = AbilityDelegatorRegistry.getAbilityDelegator();
+  await abilityDelegator.startAbility({
+    bundleName: 'ohos.samples.etsappaccountmanager',
+    abilityName: 'TestAbility'
+  });
+  await driver.delayMs(WAIT_TIME * 2);
+}
+
+async function clickById(id: string): Promise<void> {
+  await driver.assertComponentExist(ON.id(id));
+  let component: Component = await driver.findComponent(ON.id(id));
+  await component.click();
+  await driver.delayMs(WAIT_TIME);
+}
+
+async function isTextVisible(text: string): Promise<boolean> {
+  try {
+    await driver.assertComponentExist(ON.text(text));
+    return true;
+  } catch (error) {
+    return false;
+  }
+}
+
+export default function accountInfoRouteTest(): void {
+  describe('AccountInfoRouteTest', () => {
+    it(BUNDLE + 'ModifyRouteKeepsUserInfo_001', 0, async () => {
+      await startTestAbility();
+      expect(await isTextVisible(EMAIL)).assertTrue();
+      expect(await isTextVisible(SIGNATURE)).assertTrue();
+
+      await clickById('modify');
+
+      expect(await isTextVisible(EMAIL)).assertTrue();
+      expect(await isTextVisible(SIGNATURE)).assertTrue();
+    })
+  })
+}
