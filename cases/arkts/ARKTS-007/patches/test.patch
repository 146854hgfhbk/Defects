+import router from '@ohos.router';
+
+@Entry
+@Component
+struct ModifyProbe {
+  @State email: string = '';
+  @State signature: string = '';
+
+  aboutToAppear() {
+    let params = router.getParams();
+    if (params !== undefined) {
+      this.email = <string>params['email'];
+      this.signature = <string>params['signature'];
+    }
+  }
+
+  build() {
+    Column() {
+      Text(this.email)
+        .id('routeEmail')
+        .fontSize(20)
+      Text(this.signature)
+        .id('routeSignature')
+        .fontSize(20)
+    }
+    .width('100%')
+    .height('100%')
+    .justifyContent(FlexAlign.Center)
+  }
+}
