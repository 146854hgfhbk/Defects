+import { describe, it } from '@ohos/hypium';
+import { Driver, ON } from '@ohos.UiTest';
+
+export default function pictureLimitDialogTest() {
+  describe('PictureLimitDialogTest', function () {
+    it('ShowsDialogWhenAlbumReturnsTenPictures_001', 0, async function (done) {
+      let driver = Driver.create();
+      await driver.delayMs(1000);
+      await driver.assertComponentExist(ON.id('triggerLimit'));
+      let trigger = await driver.findComponent(ON.id('triggerLimit'));
+      await trigger.click();
+      await driver.delayMs(1000);
+      await driver.assertComponentExist(ON.type('AlertDialog'));
+      done();
+    })
+  })
+}
