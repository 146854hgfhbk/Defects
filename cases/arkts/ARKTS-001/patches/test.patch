+import { describe, it, expect } from '@ohos/hypium';
+import { Browser } from '../../../main/ets/model/Browser';
+
+const BUNDLE: string = 'BrowserControllerApi_';
+
+class CapturingController {
+  public lastUrlArg: string | Record<string, string> | undefined = undefined;
+
+  loadUrl(url: string | Record<string, string>): void {
+    this.lastUrlArg = url;
+  }
+
+  accessBackward(): boolean {
+    return false;
+  }
+
+  accessForward(): boolean {
+    return false;
+  }
+
+  refresh(): void {
+  }
+}
+
+export default function browserControllerApiTest(): void {
+  describe('BrowserControllerApiTest', () => {
+    it(BUNDLE + 'loadUrlUsesStringWebviewControllerApi_001', 0, () => {
+      let browser = new Browser();
+      let controller = new CapturingController();
+      browser.webControllerArray = [{ controller: controller, isRegistered: false }] as any;
+      browser.tabArrayIndex = 0;
+
+      browser.loadUrl('example.com/path');
+
+      expect(typeof controller.lastUrlArg).assertEqual('string');
+      expect(controller.lastUrlArg as string).assertEqual('https://example.com/path');
+    });
+  });
+}
