+import { describe, it, expect } from '@ohos/hypium';
+import { Browser } from '../../../main/ets/model/Browser';
+
+const BUNDLE: string = 'Browser_';
+
+function callAndCountCrash(action: () => void): number {
+  try {
+    action();
+    return 0;
+  } catch (error) {
+    return 1;
+  }
+}
+
+export default function browserControllerGuardTest(): void {
+  describe('BrowserControllerGuardTest', () => {
+    it(BUNDLE + 'MissingCurrentController_001', 0, () => {
+      let browser: Browser = new Browser();
+      browser.webControllerArray.pop();
+      browser.setTabArrayIndex(0);
+
+      let crashCount = 0;
+      crashCount += callAndCountCrash(() => browser.loadUrl('www.example.com'));
+      crashCount += callAndCountCrash(() => browser.Back());
+      crashCount += callAndCountCrash(() => browser.Forward());
+      crashCount += callAndCountCrash(() => browser.Refresh());
+
+      expect(crashCount).assertEqual(0);
+    })
+  })
+}
