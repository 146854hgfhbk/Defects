+import { describe, it, expect } from '@ohos/hypium'
+import MediaManager from '../../../main/ets/model/MediaManager'
+
+export default function mediaManagerDeleteFileTest() {
+  describe('mediaManagerDeleteFileTest', function () {
+    it('Recorder_DeleteFileUsesTrash_001', 0, async function (done) {
+      let manager = Object.create(MediaManager.prototype) as MediaManager
+      let trashFlag = false
+      let fakeFileAsset = {
+        title: 'recorder.m4a',
+        uri: 'file://recorder.m4a',
+        trash: async (isTrash: boolean): Promise<void> => {
+          trashFlag = isTrash
+        }
+      }
+
+      try {
+        await manager.deleteFile(fakeFileAsset as any)
+        expect(trashFlag).assertTrue()
+      } catch (err) {
+        expect(false).assertTrue()
+      }
+      done()
+    })
+  })
+}
