+import { describe, it, expect } from '@ohos/hypium';
+import { Driver } from '@ohos.UiTest';
+import AbilityDelegatorRegistry from '@ohos.app.ability.abilityDelegatorRegistry';
+import hilog from '@ohos.hilog';
+import hidebug from '@ohos.hidebug';
+
+const TAG = '[Sample_Clock_CanvasMemory]';
+const DOMAIN = 0xF811;
+const BUNDLE = 'Clock_';
+const CLOCK_BUNDLE_NAME = 'ohos.samples.etsclock';
+const CLOCK_ABILITY_NAME = 'MainAbility';
+const MAX_PSS_GROWTH_KB = 1024;
+
+function sleep(time: number): Promise<void> {
+  return new Promise<void>((resolve) => {
+    setTimeout(resolve, time);
+  });
+}
+
+async function runShellCommand(command: string): Promise<AbilityDelegatorRegistry.ShellCmdResult> {
+  const delegator = AbilityDelegatorRegistry.getAbilityDelegator();
+  const result = await delegator.executeShellCommand(command, 20);
+  hilog.info(DOMAIN, TAG, 'command %{public}s exit %{public}d stdout %{public}s',
+    command, result.exitCode, result.stdResult);
+  return result;
+}
+
+function isDigit(char: string): boolean {
+  return char >= '0' && char <= '9';
+}
+
+function parseFirstNumber(text: string): number {
+  let numberText = '';
+  for (let i = 0; i < text.length; i++) {
+    const char = text.charAt(i);
+    if (isDigit(char)) {
+      numberText += char;
+    } else if (numberText.length > 0) {
+      break;
+    }
+  }
+  expect(numberText.length > 0).assertTrue();
+  return Number(numberText);
+}
+
+function splitWords(text: string): Array<string> {
+  const words: Array<string> = [];
+  let word = '';
+  for (let i = 0; i < text.length; i++) {
+    const char = text.charAt(i);
+    if (char === ' ' || char === '\t' || char === '\r' || char === '\n') {
+      if (word.length > 0) {
+        words.push(word);
+        word = '';
+      }
+    } else {
+      word += char;
+    }
+  }
+  if (word.length > 0) {
+    words.push(word);
+  }
+  return words;
+}
+
+function parseClockPssKb(text: string): number {
+  const lines = text.split('\n');
+  for (let i = 0; i < lines.length; i++) {
+    const line = lines[i].trim();
+    if (line.startsWith('Total')) {
+      return parseFirstNumber(line.substring('Total'.length));
+    }
+  }
+  expect(false).assertTrue();
+  return -1;
+}
+
+function parseClockPid(text: string): number {
+  const lines = text.split('\n');
+  for (let i = 0; i < lines.length; i++) {
+    const line = lines[i].trim();
+    if (line.endsWith(CLOCK_BUNDLE_NAME)) {
+      const words = splitWords(line);
+      expect(words.length > 1).assertTrue();
+      return parseFirstNumber(words[1]);
+    }
+  }
+  expect(false).assertTrue();
+  return -1;
+}
+
+async function getClockPid(): Promise<number> {
+  const psResult = await runShellCommand(`ps -ef | grep ${CLOCK_BUNDLE_NAME}`);
+  const pid = parseClockPid(psResult.stdResult);
+  expect(pid > 0).assertTrue();
+  return pid;
+}
+
+async function getProcessPssKb(pid: number): Promise<number> {
+  const memResult = await runShellCommand(`hidumper --mem ${pid}`);
+  const pss = parseClockPssKb(memResult.stdResult);
+  expect(pss > 0).assertTrue();
+  return pss;
+}
+
+function getCurrentPssKb(): number {
+  const pss = Number(hidebug.getPss());
+  expect(pss > 0).assertTrue();
+  return pss;
+}
+
+export default function canvasMemoryTest() {
+  describe('CanvasMemoryTest', () => {
+    it(BUNDLE + 'CanvasSaveRestoreBalance_001', 0, async () => {
+      const delegator = AbilityDelegatorRegistry.getAbilityDelegator();
+      await delegator.startAbility({
+        bundleName: CLOCK_BUNDLE_NAME,
+        abilityName: CLOCK_ABILITY_NAME
+      });
+
+      const driver = Driver.create();
+      await driver.delayMs(2000);
+      const samples: Array<number> = [];
+      for (let i = 0; i < 5; i++) {
+        samples.push(getCurrentPssKb());
+        await sleep(1500);
+      }
+
+      const first = samples[0];
+      const last = samples[samples.length - 1];
+      const growth = last - first;
+      hilog.info(DOMAIN, TAG, 'PSS samples %{public}s growth %{public}d', JSON.stringify(samples), growth);
+      expect(growth < MAX_PSS_GROWTH_KB).assertTrue();
+    });
+  });
+}
