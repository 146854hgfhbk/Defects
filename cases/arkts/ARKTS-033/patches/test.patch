+import { describe, it, expect } from '@ohos/hypium';
+import common from '@ohos.app.ability.common';
+import List from '@ohos.util.List';
+import taskpool from '@ohos.taskpool';
+import { ImageKnifeDispatcher, ImageKnifeRequestSource, ImageKnifeRequestWithSource } from '@ohos/imageknife/src/main/ets/ImageKnifeDispatcher';
+import { ImageKnifeOption, ImageKnifeRequest } from '@ohos/imageknife/Index';
+import { ImageKnifeRequestState } from '@ohos/imageknife/src/main/ets/ImageKnifeRequest';
+import { DefaultJobQueue } from '@ohos/imageknife/src/main/ets/utils/DefaultJobQueue';
+
+class RecordingDispatcher extends ImageKnifeDispatcher {
+  executedSources: Array<string> = new Array<string>();
+  executedStates: Array<ImageKnifeRequestState> = new Array<ImageKnifeRequestState>();
+
+  executeJob(request: ImageKnifeRequest): void {
+    this.executedStates.push(request.requestState);
+    this.executedSources.push(request.ImageKnifeOption.loadSrc as string);
+  }
+}
+
+function createRequest(loadSrc: string, priority?: taskpool.Priority): ImageKnifeRequest {
+  let option: ImageKnifeOption = {
+    loadSrc: loadSrc,
+    priority: priority
+  };
+  return new ImageKnifeRequest(
+    option,
+    getContext() as common.UIAbilityContext,
+    12,
+    12,
+    1,
+    {
+      showPixelMap: () => {
+      }
+    }
+  );
+}
+
+function addExecutingSlot(dispatcher: ImageKnifeDispatcher, key: string): void {
+  let requestList = new List<ImageKnifeRequestWithSource>();
+  requestList.add({
+    request: createRequest('busy-' + key),
+    source: ImageKnifeRequestSource.SRC
+  });
+  dispatcher.executingJobMap.set(key, requestList);
+}
+
+export default function DispatchProgressQueueTest() {
+  describe('DispatchProgressQueueTest', () => {
+    it('dispatchNextJobSkipsDestroyedRequestsUntilProgressRequest', 0, () => {
+      let dispatcher = new RecordingDispatcher();
+      dispatcher.setMaxRequests(1);
+      addExecutingSlot(dispatcher, 'one');
+      addExecutingSlot(dispatcher, 'two');
+
+      let destroyedRequest = createRequest('destroyed-src', taskpool.Priority.HIGH);
+      destroyedRequest.requestState = ImageKnifeRequestState.DESTROY;
+      let progressRequest = createRequest('progress-src', taskpool.Priority.LOW);
+
+      dispatcher.enqueue(destroyedRequest);
+      dispatcher.enqueue(progressRequest);
+      dispatcher.dispatchNextJob();
+
+      expect(dispatcher.executedSources.length).assertEqual(1);
+      expect(dispatcher.executedSources[0]).assertEqual('progress-src');
+      expect(dispatcher.executedStates[0]).assertEqual(ImageKnifeRequestState.PROGRESS);
+    });
+
+    it('defaultJobQueueKeepsPriorityOrdering', 1, () => {
+      let queue = new DefaultJobQueue();
+      queue.add(createRequest('normal-src', taskpool.Priority.MEDIUM));
+      queue.add(createRequest('low-src', taskpool.Priority.LOW));
+      queue.add(createRequest('high-src', taskpool.Priority.HIGH));
+
+      expect(queue.getQueueLength()).assertEqual(3);
+      expect(queue.pop()?.ImageKnifeOption.loadSrc).assertEqual('high-src');
+      expect(queue.pop()?.ImageKnifeOption.loadSrc).assertEqual('normal-src');
+      expect(queue.pop()?.ImageKnifeOption.loadSrc).assertEqual('low-src');
+      expect(queue.pop()).assertUndefined();
+    });
+  });
+}
