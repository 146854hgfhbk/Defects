+import { describe, it, expect } from '@ohos/hypium';
+import AbilityDelegatorRegistry from '@ohos.app.ability.abilityDelegatorRegistry';
+import { Driver, ON, Component } from '@ohos.UiTest';
+
+const BUNDLE_NAME: string = 'ohos.samples.AdaptiveCapabilities';
+const WAIT_START: number = 2000;
+const WAIT_PAGE: number = 1200;
+const TITLE_TOP_LIMIT: number = 150;
+const SUBTITLE_BOTTOM_LIMIT: number = 210;
+
+let delegator: AbilityDelegatorRegistry.AbilityDelegator =
+  AbilityDelegatorRegistry.getAbilityDelegator();
+
+function startMainAbility(): Promise<void> {
+  return new Promise<void>((resolve: () => void) => {
+    delegator.executeShellCommand(
+      'aa start -d 0 -a MainAbility -b ohos.samples.AdaptiveCapabilities -m entry',
+      () => {
+        resolve();
+      }
+    );
+  });
+}
+
+async function findById(driver: Driver, id: string): Promise<Component | null> {
+  try {
+    let component = await driver.findComponent(ON.id(id));
+    if (component !== undefined && component !== null) {
+      return component;
+    }
+  } catch (error) {
+  }
+  return null;
+}
+
+async function findText(driver: Driver, text: string): Promise<Component | null> {
+  try {
+    let component = await driver.findComponent(ON.text(text));
+    if (component !== undefined && component !== null) {
+      return component;
+    }
+  } catch (error) {
+  }
+  return null;
+}
+
+export default function adaptiveTitleOcclusionTest() {
+  describe('AdaptiveTitleOcclusionTestSuite', () => {
+    it('AdaptiveTitle_HeaderStaysInTopBand', 0, async () => {
+      const driver: Driver = Driver.create();
+      await startMainAbility();
+      await driver.delayMs(WAIT_START);
+
+      let manager = delegator.getAppContext().resourceManager;
+      let titleText: string = await manager.getStringByName('multiScene_header_title');
+      let subtitleText: string = await manager.getStringByName('multiScene_header_subtitle');
+
+      let entry = await findById(driver, 'TypicalSceneIndex');
+      if (entry !== null) {
+        await entry.click();
+      }
+      await driver.delayMs(WAIT_PAGE);
+      let scene = await findById(driver, 'multiScene');
+      if (scene !== null) {
+        await scene.click();
+      }
+      await driver.delayMs(WAIT_PAGE * 2);
+
+      let title = await findText(driver, titleText);
+      let subtitle = await findText(driver, subtitleText);
+      let titleTop: number = -1;
+      let subtitleBottom: number = -1;
+      if (title !== null) {
+        titleTop = (await title.getBounds()).top;
+      }
+      if (subtitle !== null) {
+        subtitleBottom = (await subtitle.getBounds()).bottom;
+      }
+
+      let display = await driver.getDisplaySize();
+      let probe: string = 'titleTop=' + titleTop + ';subtitleBottom=' + subtitleBottom +
+        ';display=' + display.x + 'x' + display.y;
+      console.info('AdaptiveTitleProbe ' + probe);
+      let headerInTopBand: boolean = title !== null && subtitle !== null &&
+        titleTop >= 0 && titleTop <= TITLE_TOP_LIMIT &&
+        subtitleBottom > 0 && subtitleBottom <= SUBTITLE_BOTTOM_LIMIT;
+      expect(headerInTopBand ? 'HEADER_INSET' : ('HEADER_DISPLACED:' + probe))
+        .assertEqual('HEADER_INSET');
+    });
+  });
+}
