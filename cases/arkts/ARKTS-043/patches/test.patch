+import UIAbility from '@ohos.app.ability.UIAbility';
+import AbilityDelegatorRegistry from '@ohos.app.ability.abilityDelegatorRegistry';
+import { describe, expect, it } from '@ohos/hypium';
+import { Driver } from '@ohos.UiTest';
+import hilog from '@ohos.hilog';
+
+const TAG = '[ClockBackgroundLifecycleTest]';
+const DOMAIN = 0xF811;
+const BUNDLE_NAME = 'ohos.samples.etsclock';
+const ABILITY_NAME = 'MainAbility';
+
+async function waitForMainAbility(): Promise<UIAbility> {
+  let delegator = AbilityDelegatorRegistry.getAbilityDelegator();
+  await delegator.startAbility({
+    bundleName: BUNDLE_NAME,
+    abilityName: ABILITY_NAME
+  });
+  let driver = Driver.create();
+  await driver.delayMs(1200);
+  let ability = await delegator.getCurrentTopAbility();
+  expect(ability !== undefined).assertTrue();
+  return ability as UIAbility;
+}
+
+export default function ClockBackgroundLifecycleTest() {
+  describe('ClockBackgroundLifecycleTest', () => {
+    it('MainAbility_BackgroundCanReturn_001', 0, async () => {
+      let delegator = AbilityDelegatorRegistry.getAbilityDelegator();
+      let driver = Driver.create();
+      let ability = await waitForMainAbility();
+      let foregroundState = delegator.getAbilityState(ability);
+      hilog.info(DOMAIN, TAG, 'foreground state=%{public}d', foregroundState);
+
+      await delegator.doAbilityBackground(ability);
+      await driver.delayMs(1500);
+      let backgroundState = delegator.getAbilityState(ability);
+      hilog.info(DOMAIN, TAG, 'background state=%{public}d', backgroundState);
+
+      let foregroundSucceeded = true;
+      try {
+        await delegator.doAbilityForeground(ability);
+      } catch (err) {
+        foregroundSucceeded = false;
+        hilog.error(DOMAIN, TAG, 'doAbilityForeground failed: %{public}s', JSON.stringify(err));
+      }
+      await driver.delayMs(1200);
+      let restoredState = delegator.getAbilityState(ability);
+      hilog.info(DOMAIN, TAG, 'restored state=%{public}d foregroundSucceeded=%{public}s',
+        restoredState, String(foregroundSucceeded));
+
+      expect(foregroundSucceeded).assertTrue();
+      expect(restoredState).assertEqual(foregroundState);
+    });
+  });
+}
