+
+import { describe, expect, it } from '@ohos/hypium'
+import { Driver, ON } from '@ohos.UiTest'
+import AbilityDelegatorRegistry from '@ohos.app.ability.abilityDelegatorRegistry'
+
+async function startMainAbility(): Promise<void> {
+  let abilityDelegator = AbilityDelegatorRegistry.getAbilityDelegator()
+  await new Promise<void>((resolve) => {
+    abilityDelegator.executeShellCommand(
+      'aa start -d 0 -a MainAbility -b ohos.samples.AdaptiveCapabilities -m entry',
+      () => {
+        resolve()
+      }
+    )
+  })
+}
+
+async function openFlexibleCapability2(driver: Driver): Promise<void> {
+  await startMainAbility()
+  await driver.delayMs(2000)
+  let atomic = await driver.findComponent(ON.text('自适应布局'))
+  await atomic.click()
+  await driver.delayMs(1000)
+  let flexible = await driver.findComponent(ON.text('拉伸能力2'))
+  await flexible.click()
+  await driver.delayMs(1200)
+}
+
+export default function flexibleCapabilityMinTest() {
+  describe('FlexibleCapabilityMinTest', () => {
+    it('FlexibleCapability2MinimumRate55_001', 0, async () => {
+      let driver: Driver = Driver.create()
+      await openFlexibleCapability2(driver)
+
+      let slider = await driver.findComponent(ON.type('Slider'))
+      let initialValue = Number(await slider.getText())
+      expect(initialValue >= 79.5).assertTrue()
+      expect(initialValue <= 80.5).assertTrue()
+
+      let sliderBounds = await slider.getBounds()
+      let sliderCenterY = Math.floor((sliderBounds.top + sliderBounds.bottom) / 2)
+      await driver.drag(sliderBounds.right - 6, sliderCenterY, sliderBounds.left + 6, sliderCenterY, 800)
+      await driver.delayMs(1000)
+
+      let minimumValue = Number(await slider.getText())
+      expect(minimumValue >= 54.5).assertTrue()
+      expect(minimumValue <= 55.5).assertTrue()
+
+      let rows = await driver.findComponents(ON.type('Row'))
+      expect(rows.length >= 2).assertTrue()
+      let cardBounds = await rows[1].getBounds()
+      let displaySize = await driver.getDisplaySize()
+      let cardWidth = cardBounds.right - cardBounds.left
+      expect(cardWidth >= Math.floor(displaySize.x * 0.53)).assertTrue()
+      expect(cardWidth <= Math.floor(displaySize.x * 0.57)).assertTrue()
+    })
+  })
+}
