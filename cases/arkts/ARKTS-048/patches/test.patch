+import { describe, it, expect } from '@ohos/hypium';
+import { Driver, ON } from '@ohos.UiTest';
+
+export default function modeSwitchLayoutTest() {
+  describe('modeSwitchLayoutTest', () => {
+    it('Camera_ModeSwitchIconSize_001', 0, async () => {
+      let driver: Driver = Driver.create();
+      await driver.delayMs(1000);
+      let captureButton = await driver.findComponent(ON.id('CaptureOrVideoButton'));
+      let bounds = await captureButton.getBounds();
+      let width = bounds.right - bounds.left;
+      let height = bounds.bottom - bounds.top;
+      expect(width < 190).assertTrue();
+      expect(height < 190).assertTrue();
+    })
+  })
+}
