+import { describe, expect, it } from '@ohos/hypium'
+import AbilityDelegatorRegistry from '@ohos.app.ability.abilityDelegatorRegistry'
+import { Driver, ON, Component, MatchPattern } from '@ohos.UiTest'
+
+const DRIVER = Driver.create()
+const BUNDLE_NAME = 'ohos.samples.componentcollection'
+const ABILITY_NAME = 'MainAbility'
+const DELAY_MS = 1000
+const HALF_DELAY_MS = 500
+
+function startMainAbility(): Promise<void> {
+  return new Promise<void>((resolve, reject) => {
+    let abilityDelegator: AbilityDelegatorRegistry.AbilityDelegator = AbilityDelegatorRegistry.getAbilityDelegator()
+    abilityDelegator.startAbility({
+      bundleName: BUNDLE_NAME,
+      abilityName: ABILITY_NAME
+    }, (err) => {
+      if (err && err.code !== 0) {
+        reject(err)
+        return
+      }
+      resolve()
+    })
+  })
+}
+
+async function getString(resource: Resource): Promise<string> {
+  let abilityDelegator: AbilityDelegatorRegistry.AbilityDelegator = AbilityDelegatorRegistry.getAbilityDelegator()
+  let context = await abilityDelegator.getAppContext()
+  return await context.resourceManager.getStringValue(resource)
+}
+
+async function clickByText(text: string): Promise<void> {
+  await DRIVER.assertComponentExist(ON.text(text, MatchPattern.CONTAINS))
+  let component = await DRIVER.findComponent(ON.text(text, MatchPattern.CONTAINS))
+  await component.click()
+  await DRIVER.delayMs(DELAY_MS)
+}
+
+async function openEffectsPage(): Promise<void> {
+  await DRIVER.assertComponentExist(ON.id('tabBar1'))
+  let universalTab = await DRIVER.findComponent(ON.id('tabBar1'))
+  await universalTab.click()
+  await DRIVER.delayMs(HALF_DELAY_MS)
+
+  let effectsTitle = await getString($r('app.string.components_effects'))
+  let list = await DRIVER.findComponent(ON.id('list_001'))
+  let effectsItem: Component = await list.scrollSearch(ON.text(effectsTitle, MatchPattern.CONTAINS))
+  await effectsItem.click()
+  await DRIVER.delayMs(DELAY_MS)
+}
+
+export default function effectsShadowOffsetRangeTest() {
+  describe('EffectsShadowOffsetRangeTest', () => {
+    it('shadowTabShouldExposeNegativeAndPositiveOffsetRange', 0, async () => {
+      await startMainAbility()
+      await DRIVER.delayMs(DELAY_MS)
+      await openEffectsPage()
+
+      await clickByText(await getString($r('app.string.shadow')))
+      await DRIVER.delayMs(HALF_DELAY_MS)
+
+      await DRIVER.assertComponentExist(ON.text(await getString($r('app.string.shadow_effects')), MatchPattern.CONTAINS))
+      await DRIVER.assertComponentExist(ON.text(await getString($r('app.string.x_offset')), MatchPattern.CONTAINS))
+      await DRIVER.assertComponentExist(ON.text(await getString($r('app.string.y_offset')), MatchPattern.CONTAINS))
+
+      await DRIVER.assertComponentExist(ON.text('-40', MatchPattern.CONTAINS))
+      await DRIVER.assertComponentExist(ON.text('40', MatchPattern.CONTAINS))
+      let positiveFortyLabels = await DRIVER.findComponents(ON.text('40', MatchPattern.EQUALS))
+      expect(positiveFortyLabels.length >= 2).assertTrue()
+    })
+  })
+}
