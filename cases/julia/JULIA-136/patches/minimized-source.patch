--- a/src/errors.jl
+++ b/src/errors.jl
@@ -20,14 +20,6 @@ const allowedkeywords = (
     :force_dtmin,
     :internalnorm,
     :controller,
-    :gamma,
-    :beta1,
-    :beta2,
-    :qmax,
