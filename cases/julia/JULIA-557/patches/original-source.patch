+function is_anonymous_test_function(@nospecialize(ex))
+    isexpr(ex, :->, 2) && return true
+    isexpr(ex, :function, 2) || return false
+    sig = first(ex.args)
+    while isexpr(sig, (:(::), :where)) && !isempty(sig.args)
+        sig = first(sig.args)
+    end
+    return isexpr(sig, :tuple)
+end
