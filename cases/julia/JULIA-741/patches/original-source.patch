+        # global x   ==>  (global x)
+        # local x    ==>  (local x)
+        # global x,y ==>  (global x y)
+        bump(ps, TRIVIA_FLAG)
+        const_mark = nothing
+        if peek(ps) == K"const"
+            const_mark = position(ps)
+            bump(ps, TRIVIA_FLAG)
+        end
+        had_assignment = parse_global_local_const_vars(ps)
