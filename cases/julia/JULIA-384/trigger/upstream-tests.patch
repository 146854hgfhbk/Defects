+
+    # Test inconsistent linear systems
+    A, b, c = ssy_mo_breakdown(transpose)
+    K = [I A; A' I]
+    d = [b; c]
+    n, m = size(K)
+    p = rank(K)
+    @test(p < n)
+    x, y, stats = gpmr(A, A', b, c)
+    r =  d - K * [x; y]
+    Aresid = norm(K' * r) / norm(K' * d)
+    @test(Aresid ≤ gpmr_tol)
+    @test(stats.inconsistent)
   end
 
